    pto.tmul ins(%pto128, %pto132 : !pto.tile_buf<loc=vec, dtype=i16, rows=40, cols=32, v_row=40, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=i16, rows=40, cols=32, v_row=40, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto113 : !pto.tile_buf<loc=vec, dtype=i16, rows=40, cols=32, v_row=40, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      %pto133 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=40, cols=32, v_row=40, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
      pto.tcvt ins(%pto93 : !pto.tile_buf<loc=vec, dtype=i16, rows=40, cols=32, v_row=40, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto133 : !pto.tile_buf<loc=vec, dtype=f16, rows=40, cols=32, v_row=40, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // even value i16 -> f16
