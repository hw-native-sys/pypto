      pto.tadd ins(%pto21, %pto20 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=40, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=40, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto21 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=40, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // fold chunk
