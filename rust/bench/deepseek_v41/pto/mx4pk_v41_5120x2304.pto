      pto.tcolsum ins(%pto11 : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=40, v_row=32, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto14 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=40, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      pto.ttrans ins(%pto10, %pto13 : !pto.tile_buf<loc=vec, dtype=f32, rows=40, cols=32, v_row=40, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=40, v_row=32, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto12 : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=40, v_row=32, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // odd
      pto.tcolsum ins(%pto12 : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=40, v_row=32, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto15 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=40, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      %pto137 = pto.partition_view %pto1, offsets = [%r, %c40], sizes = [%c1, %c40] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x40xf32>
      pto.tload ins(%pto137 : !pto.partition_tensor_view<1x40xf32>) outs(%pto16 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=40, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // even-block scales (pre-halved)
      %pto138 = pto.partition_view %pto1, offsets = [%r, %c120], sizes = [%c1, %c40] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x40xf32>
      pto.tload ins(%pto138 : !pto.partition_tensor_view<1x40xf32>) outs(%pto17 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=40, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // odd-block scales
