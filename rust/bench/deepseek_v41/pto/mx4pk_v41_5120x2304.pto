    pto.tadd ins(%pto126, %pto125 : !pto.tile_buf<loc=vec, dtype=i16, rows=40, cols=32, v_row=40, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=i16, rows=40, cols=32, v_row=40, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto127 : !pto.tile_buf<loc=vec, dtype=i16, rows=40, cols=32, v_row=40, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
