      pto.tmul ins(%pto15, %pto17 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=40, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=40, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto19 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=40, v_row=1, v_col=40, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
