    %pto30 = pto.partition_view %pto29, offsets = [%c0, %c0], sizes = [%c512, %c1] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<512x1xf32>
    pto.tstore ins(%pto28 : !pto.tile_buf<loc=vec, dtype=f32, rows=512, cols=1, v_row=512, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>) outs(%pto30 : !pto.partition_tensor_view<512x1xf32>)
    return
  }
}
