// Kimi K3 (kimi_k3), shapes read from the released model's own config.json.
// Form: llvm.func + hacc.entry + __tile_* -- the shape the emitters consume.
module {
  llvm.func @k3_kda_delta_128(%arg0: !llvm.ptr<1>, %arg1: !llvm.ptr<1>, %arg2: !llvm.ptr<1>, %arg3: !llvm.ptr<1>, %arg4: !llvm.ptr<1>) attributes {hacc.entry} {
    %z = llvm.mlir.constant(0 : i32) : i32
    %r = llvm.mlir.constant(1 : i32) : i32
    %cl = llvm.mlir.constant(128 : i32) : i32
    %cdecay = llvm.mlir.constant(0.5 : f32) : f32
    %cbeta = llvm.mlir.constant(1.0 : f32) : f32
    %q = llvm.call @__tile_load_f32(%arg0, %r, %cl) : (!llvm.ptr<1>, i32, i32) -> i32
    %k = llvm.call @__tile_load_f32(%arg1, %r, %cl) : (!llvm.ptr<1>, i32, i32) -> i32
    %v = llvm.call @__tile_load_f32(%arg2, %r, %cl) : (!llvm.ptr<1>, i32, i32) -> i32
    %s = llvm.call @__tile_load_f32(%arg3, %r, %cl) : (!llvm.ptr<1>, i32, i32) -> i32
    %qk = llvm.call @__tile_mul_f32(%z, %q, %k, %r, %cl) : (i32, i32, i32, i32, i32) -> i32
    %qks = llvm.call @__tile_reduce_sum_f32(%z, %qk, %r, %cl) : (i32, i32, i32, i32) -> i32
    %qkb = llvm.call @__tile_row_expand_f32(%z, %qks, %cl) : (i32, i32, i32) -> i32
    %g1 = llvm.call @__tile_mul_f32(%z, %qkb, %v, %r, %cl) : (i32, i32, i32, i32, i32) -> i32
    %g2 = llvm.call @__tile_scale_f32(%z, %g1, %cbeta, %r, %cl) : (i32, i32, f32, i32, i32) -> i32
    %sd = llvm.call @__tile_scale_f32(%z, %s, %cdecay, %r, %cl) : (i32, i32, f32, i32, i32) -> i32
    %o = llvm.call @__tile_add_f32(%z, %sd, %g2, %r, %cl) : (i32, i32, i32, i32, i32) -> i32
    llvm.call @__tile_store_f32(%arg4, %o, %r, %cl) : (!llvm.ptr<1>, i32, i32, i32) -> ()

    llvm.return
  }
}
