// Kimi K3 (kimi_k3), shapes read from the released model's own config.json.
// Form: llvm.func + hacc.entry + __tile_* -- the shape the emitters consume.
module {
  llvm.func @k3_router_896_16(%arg0: !llvm.ptr<1>, %arg1: !llvm.ptr<1>, %arg2: !llvm.ptr<1>) attributes {hacc.entry} {
    %z = llvm.mlir.constant(0 : i32) : i32
    %r = llvm.mlir.constant(1 : i32) : i32
    %cl = llvm.mlir.constant(896 : i32) : i32
    %k = llvm.mlir.constant(16 : i32) : i32
    %v = llvm.call @__tile_load_f32(%arg0, %r, %cl) : (!llvm.ptr<1>, i32, i32) -> i32
    %p = llvm.call @__tile_sigmoid_f32(%z, %v, %r, %cl) : (i32, i32, i32, i32) -> i32
    %o = llvm.call @__tile_topk_f32(%p, %p, %arg2, %r, %cl, %k) : (i32, i32, !llvm.ptr<1>, i32, i32, i32) -> i32
    llvm.call @__tile_store_f32(%arg1, %o, %r, %k) : (!llvm.ptr<1>, i32, i32, i32) -> ()
    llvm.return
  }
}
