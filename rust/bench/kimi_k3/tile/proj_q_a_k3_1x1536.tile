// Kimi K3 (kimi_k3), shapes read from the released model's own config.json.
// Form: llvm.func + hacc.entry + __tile_* -- the shape the emitters consume.
module {
  llvm.func @k3_proj_q_a(%arg0: !llvm.ptr<1>, %arg1: !llvm.ptr<1>, %arg2: !llvm.ptr<1>) attributes {hacc.entry} {
    %z = llvm.mlir.constant(0 : i32) : i32
    %r = llvm.mlir.constant(1 : i32) : i32
    %cr1 = llvm.mlir.constant(1 : i32) : i32
    %cl = llvm.mlir.constant(1536 : i32) : i32
    %x = llvm.call @__tile_load_f32(%arg0, %r, %cl) : (!llvm.ptr<1>, i32, i32) -> i32
    %w = llvm.call @__tile_load_f32(%arg1, %r, %cl) : (!llvm.ptr<1>, i32, i32) -> i32
    %m = llvm.call @__tile_mul_f32(%z, %x, %w, %r, %cl) : (i32, i32, i32, i32, i32) -> i32
    %o = llvm.call @__tile_reduce_sum_f32(%z, %m, %r, %cl) : (i32, i32, i32, i32) -> i32
    llvm.call @__tile_store_f32(%arg2, %o, %cr1, %cr1) : (!llvm.ptr<1>, i32, i32, i32) -> ()
    llvm.return
  }
}
