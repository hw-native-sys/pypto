      %pto40 = pto.partition_view %pto20, offsets = [%off, %pto9], sizes = [%pto11, %pto12] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<16x128xf32>
      pto.tload ins(%pto40 : !pto.partition_tensor_view<16x128xf32>) outs(%pto22 : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      pto.ttrans ins(%pto22, %pto24 : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=128, cols=16, v_row=128, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto25 : !pto.tile_buf<loc=vec, dtype=f32, rows=128, cols=16, v_row=128, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      pto.tcolexpand ins(%pto28 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=16, v_row=1, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto26 : !pto.tile_buf<loc=vec, dtype=f32, rows=128, cols=16, v_row=128, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      pto.barrier <PIPE_ALL>
