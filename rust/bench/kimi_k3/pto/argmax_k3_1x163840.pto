    %pto74 = "pto.tgetval"(%pto23, %pto28) : (!pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=1, v_row=1, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>, index) -> f32
    %pto75 = "pto.tgetval"(%pto22, %pto29) : (!pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index) -> i32
    %pto76 = arith.cmpf ogt, %pto74, %pto72 : f32
    %pto77 = arith.constant 122880 : i32
    %pto78 = arith.addi %pto75, %pto77 : i32
    %pto79 = arith.select %pto76, %pto74, %pto72 : f32
    %pto80 = arith.select %pto76, %pto78, %pto73 : i32
    %pto81 = "pto.tgetval"(%pto26, %pto28) : (!pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=1, v_row=1, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>, index) -> f32
    %pto82 = "pto.tgetval"(%pto25, %pto29) : (!pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index) -> i32
    %pto83 = arith.cmpf ogt, %pto81, %pto79 : f32
    %pto84 = arith.constant 143360 : i32
    %pto85 = arith.addi %pto82, %pto84 : i32
    %pto86 = arith.select %pto83, %pto81, %pto79 : f32
    %pto87 = arith.select %pto83, %pto85, %pto80 : i32
    %pto88 = arith.index_cast %pto87 : i32 to index
    %pto89 = arith.constant 0 : i64
    "pto.tsetval"(%pto1, %pto88, %pto89) : (!pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>, index, i64) -> ()
    %pto90 = pto.make_tensor_view %arg1, shape = [%c1, %c1], strides = [%c1, %c1] : !pto.tensor_view<?x?xi32>
    %pto91 = pto.partition_view %pto90, offsets = [%c0, %c0], sizes = [%c1, %c1] : !pto.tensor_view<?x?xi32> -> !pto.partition_tensor_view<1x1xi32>
    pto.tstore ins(%pto1 : !pto.tile_buf<loc=vec, dtype=i32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto91 : !pto.partition_tensor_view<1x1xi32>)
    return
  }
}
