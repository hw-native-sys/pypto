// GLM-5.3-Flash (glm5-next), shapes read from the model's own GGUF.
// Form: llvm.func + hacc.entry + __tile_* -- the shape the emitters consume.
module {
  llvm.func @glm53_embedding_4096(%arg0: !llvm.ptr<1>, %arg1: !llvm.ptr<1>, %arg2: !llvm.ptr<1>) attributes {hacc.entry} {
    %z = llvm.mlir.constant(0 : i32) : i32
    %d = llvm.mlir.constant(4096 : i32) : i32
    %n = llvm.mlir.constant(1 : i32) : i32
    %e8 = llvm.mlir.constant(8 : i32) : i32
    %ti = llvm.call @__tile_load_f32(%arg1, %n, %e8) : (!llvm.ptr<1>, i32, i32) -> i32
    %idx = llvm.call @__tile_get_value_f32(%ti, %z) : (i32, i32) -> i32
    %off = llvm.mul %idx, %d : i32
    %row = llvm.call @__tile_load_at_f32(%arg0, %off, %n, %d) : (!llvm.ptr<1>, i32, i32, i32) -> i32
    llvm.call @__tile_store_f32(%arg2, %row, %n, %d) : (!llvm.ptr<1>, i32, i32, i32) -> ()
    llvm.return
  }
}
