// GLM-5.3-Flash (glm5-next), shapes read from the model's own GGUF.
// Form: llvm.func + hacc.entry + __tile_* -- the shape the emitters consume.
module {
  llvm.func @glm53_router_288_8(%arg0: !llvm.ptr<1>, %arg1: !llvm.ptr<1>, %arg2: !llvm.ptr<1>) attributes {hacc.entry} {
    %r = llvm.mlir.constant(1 : i32) : i32
    %cl = llvm.mlir.constant(288 : i32) : i32
    %k = llvm.mlir.constant(8 : i32) : i32
    %v = llvm.call @__tile_load_f32(%arg0, %r, %cl) : (!llvm.ptr<1>, i32, i32) -> i32
    %o = llvm.call @__tile_topk_f32(%v, %v, %arg2, %r, %cl, %k) : (i32, i32, !llvm.ptr<1>, i32, i32, i32) -> i32
    llvm.call @__tile_store_f32(%arg1, %o, %r, %k) : (!llvm.ptr<1>, i32, i32, i32) -> ()
    llvm.return
  }
}
