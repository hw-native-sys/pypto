// GLM-5.3-Flash (glm5-next), shapes read from the model's own GGUF.
// Form: llvm.func + hacc.entry + __tile_* -- the shape the emitters consume.
module {
  llvm.func @glm53_attn_decode_256(%arg0: !llvm.ptr<1>, %arg1: !llvm.ptr<1>, %arg2: !llvm.ptr<1>, %arg3: !llvm.ptr<1>) attributes {hacc.entry} {
    %z = llvm.mlir.constant(0 : i32) : i32
    %r = llvm.mlir.constant(1 : i32) : i32
    %s = llvm.mlir.constant(2048 : i32) : i32
    %cl = llvm.mlir.constant(256 : i32) : i32
    %q = llvm.call @__tile_load_f32(%arg0, %r, %cl) : (!llvm.ptr<1>, i32, i32) -> i32
    %o = llvm.call @__tile_attention_blocked_f32(%z, %q, %arg1, %arg2, %s, %cl) : (i32, i32, !llvm.ptr<1>, !llvm.ptr<1>, i32, i32) -> i32
    llvm.call @__tile_store_f32(%arg3, %o, %r, %cl) : (!llvm.ptr<1>, i32, i32, i32) -> ()
    llvm.return
  }
}
