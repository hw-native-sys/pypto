    }

    if (ORACLE == 42) {
        // TOP-K: the k INDICES of the k largest values, in descending value order,
        // ties broken by the LOWER index first -- which is what the emitted arm
        // implements (k passes of ReduceMax + first-hit scan, masking each taken
        // position). `MV_N` carries k.
        //
        // WHAT THIS DOES NOT COVER, said plainly because the obligation on an added
        // oracle is to print it: the kernel has TWO outputs, the k values through
        // gm1 and the k indices through gm2, and at KERNEL_ARGS == 3 this harness
        // copies back gm2 ALONE. So the indices are compared and the VALUE STORE is
        // not. It is not a small gap and it is not a large one: the indices identify
        // the selection completely, and the value the arm writes is the same
        // `__tk_best` the index was found for, so what is unchecked is whether that
        // value reached the right slot of the other buffer. Widening the copy-back
        // would overwrite `b`, which several existing oracles read as an INPUT, so it
        // is not a change this oracle may make.
        //
        // The expected answer is computed HERE from `a`, never from the input block
        // that built it.
        const int k = MV_N;
        if (k <= 0 || k > n || k > 256 || n > (1 << 21)) {
            printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", k, k, 0.0, 0.0);
            printf("ORACLE 42 refuses: k = MV_N = %d against n = %d. Pass k as MV_N.\n", k, n);
            printf("FAIL\n");
            aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
            aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
            CHECK(aclrtResetDevice(0)); aclFinalize();
            return 2;
        }
        const int32_t *idx_out = reinterpret_cast<const int32_t *>(c.data());
        // k selection passes in f64, the same algorithm the kernel runs, so the tie
        // policy is compared rather than guessed at.
        static bool taken[1 << 21];
        for (int i = 0; i < n; ++i) taken[i] = false;
        static int want[256];
        int bad = 0, first_bad = -1;
        for (int j = 0; j < k; ++j) {
            double best = -1e300;
            int at = -1;
            for (int i = 0; i < n; ++i) {
                if (taken[i]) continue;
                const double x = static_cast<double>(a[i]);
                if (x > best) { best = x; at = i; }
            }
            want[j] = at;
            taken[at] = true;
            if (static_cast<int>(idx_out[j]) != at) {
                ++bad;
                if (first_bad < 0) first_bad = j;
            }
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", k, bad, 0.0, 0.0);
        // The first disagreement, and the SHAPE of the expected answer -- an argmax
        // oracle that printed only a verdict could not say whether the run had
        // exercised anything. `spread` is how far apart the selected positions are:
        // a head extract would report k-1.
        int lo = n, hi = 0;
        for (int j = 0; j < k; ++j) {
            if (want[j] < lo) lo = want[j];
            if (want[j] > hi) hi = want[j];
        }
        printf("topk k=%d n=%d spread=%d want[0..3]=%d,%d,%d,%d got[0..3]=%d,%d,%d,%d\n",
               k, n, hi - lo,
               want[0], k > 1 ? want[1] : -1, k > 2 ? want[2] : -1, k > 3 ? want[3] : -1,
               static_cast<int>(idx_out[0]),
               k > 1 ? static_cast<int>(idx_out[1]) : -1,
               k > 2 ? static_cast<int>(idx_out[2]) : -1,
               k > 3 ? static_cast<int>(idx_out[3]) : -1);
        if (bad) printf("first disagreement at rank %d\n", first_bad);
        printf("NOT COVERED: the k values through gm1 -- arity 3 copies back gm2 alone\n");
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 41) {
        // ARGMAX: out[0] is the INDEX of the row maximum, as an int32, and the tie
        // policy is the LOWEST such index -- which is what the emitted scan
        // implements (`== best`, first hit, break).
        //
        // The expected index is computed HERE from `a`, never taken from the input
        // block that built it, so the two cannot drift apart: change the input and
        // this still measures the kernel.
        //
        // The output is read as int32 because the kernel's `.tile` now declares
        // `__tile_store_i32` for it. Before 2026-11-08 it declared a f32 store for
        // an integer and the AscendC arm wrote a TILE_SUBSTITUTION about it -- not
        // the emitter's choice to make, since the source asked for the f32. With the
        // store typed there is nothing to substitute, and an oracle that read the
        // slot as f32 would now be reading the wrong bytes.
