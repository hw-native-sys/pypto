                    static_cast<double>(ac) * static_cast<double>(sci[nn]);
                const double got = static_cast<double>(ch[m * N + nn]);
                const double d = std::fabs(got - ref);
                const double den = std::fabs(ref) > 1e-12 ? std::fabs(ref) : 1.0;
                const double aref = std::fabs(ref);
