        const int8_t *bi = reinterpret_cast<const int8_t *>(b.data());
        const float *sci = s.data();
        const __fp16 *ch = reinterpret_cast<const __fp16 *>(c.data());
        double mx_abs = 0.0, mx_rel = 0.0, rmin = 1e300, rmax = 0.0;
        long long acc_absmax = 0;
        int wrong = 0;
        long long first_bad = -1;
        std::vector<long long> accrow(static_cast<size_t>(N));
        for (long long m = 0; m < M; ++m) {
            accrow.assign(static_cast<size_t>(N), 0);
            for (long long k = 0; k < K; ++k) {
                const long long av = ai[m * K + k];
                const int8_t *brow = bi + k * N;
                for (long long nn = 0; nn < N; ++nn)
                    accrow[static_cast<size_t>(nn)] +=
