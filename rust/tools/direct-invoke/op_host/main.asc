        printf("dtype=i8->f16 M=%lld K=%lld N=%lld n=%d acc_absmax=%lld (0 or near 0 "
               "means the fill CANCELLED and a structural error can score clean; "
               "measured 204 at K=64 N=48 and 182 at K=5120 N=2304) "
               "ref_abs %.6e .. %.6e first_bad=%lld\n",
