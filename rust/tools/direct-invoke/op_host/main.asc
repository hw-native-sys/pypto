#if ORACLE == 51
    if (1) {
        // f32 -> i8 quantize, scored against convention A and REPORTING all four.
        const long long R = MV_N, CL = MV_K;
        const long long tot = R * CL;
        if (R <= 0 || CL <= 0 || tot > static_cast<long long>(n)) {
            printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, n, 0.0, 0.0);
            printf("ORACLE 51 refuses: R=%lld CL=%lld needs %lld f32 elements but n = %d. "
                   "R is MV_N and CL is MV_K.\n", R, CL, tot, n);
            printf("FAIL\n");
            aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
            aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
            CHECK(aclrtResetDevice(0)); aclFinalize();
            return 2;
        }
        const float *xf = a.data();
        const float sc = b.data()[0];
        const int8_t *q = reinterpret_cast<const int8_t *>(c.data());
        long long mA = 0, mB = 0, mC = 0, mD = 0, mE = 0, sat = 0;
        int wrong = 0;
        long long first_bad = -1;
        double mx_abs = 0.0;
        for (long long i = 0; i < tot; ++i) {
            const double v = static_cast<double>(xf[i]);
            const double div = v / static_cast<double>(sc);
            const double mul = v * static_cast<double>(sc);
            // round half AWAY FROM ZERO, which is what llround does, stated because
            // half-to-even would change 0.25-step inputs and silently shift the whole
            // comparison.
            const long long rdiv = std::llround(div);
            // CONVENTION E, ROUND-HALF-TO-EVEN, added 2026-11-09 before the arm was
            // written rather than after it failed. `std::llround` is half AWAY FROM
            // ZERO, which is what tile_std's "round(x / scale)" means in Rust. But the
            // only rounding modes this tree's emitter uses are CAST_NONE and
            // CAST_RINT, and CAST_RINT is half-to-EVEN. This fill has 0.25 steps
            // against a 0.5 scale, so 49.3% of x/s values land exactly on .5 -- and
            // the two modes then disagree on 10092 of 40960 elements, 24.6%.
            // Without this arm the first emission would have FAILED with nothing in
            // the table able to name why, which is the outcome the table exists to
            // prevent. std::nearbyint under the default rounding direction is
            // half-to-even.
            const long long rnear = static_cast<long long>(std::nearbyint(div));
            const long long rmul = std::llround(mul);
            const long long tdiv = static_cast<long long>(div);
            // THE SCORED CONVENTION IS THE DECLARED ONE, corrected 2026-11-09.
            // tile_std/src/tile.rs:1014 states the contract outright:
            //   "Symmetric INT8 quantize: round(x / scale), clamped to [-128, 127]."
            // This oracle first scored a clamp to [-127, 127], which is a DIFFERENT
            // convention -- it would have reported FAIL on a correct kernel and the
            // table would have named the clamp (182 of 40960 elements separate them).
            // The discriminator would have caught it; the primary should not have
            // needed catching. Read the declaration before choosing what to score.
            const long long qA = rdiv < -128 ? -128 : (rdiv > 127 ? 127 : rdiv);
            const long long qB = rmul < -128 ? -128 : (rmul > 127 ? 127 : rmul);
            const long long qC = tdiv < -128 ? -128 : (tdiv > 127 ? 127 : tdiv);
            const long long qD = rdiv < -127 ? -127 : (rdiv > 127 ? 127 : rdiv);
            const long long qE = rnear < -128 ? -128 : (rnear > 127 ? 127 : rnear);
            if (rdiv <= -128 || rdiv >= 127) ++sat;
            const long long got = q[i];
            if (got == qA) ++mA;
            if (got == qB) ++mB;
            if (got == qC) ++mC;
            if (got == qD) ++mD;
            if (got == qE) ++mE;
            const double d = std::fabs(static_cast<double>(got - qA));
            if (d > mx_abs) mx_abs = d;
            if (got != qA) {
                ++wrong;
                if (first_bad < 0) first_bad = i;
            }
        }
        printf("elements=%lld wrong=%d max_abs=%.3e max_rel=%.3e\n",
               tot, wrong, mx_abs, tot ? mx_abs / 127.0 : 0.0);
        // THE CONVENTION TABLE IS THE POINT. A FAIL with A at 1% and B at 99% is not
        // the same result as a FAIL with every convention low: the first says the
        // kernel multiplies where this oracle divides, the second says something else
        // is wrong. Reporting only a verdict would collapse those into one outcome.
        printf("dtype=f32->i8 R=%lld CL=%lld scale=%.6f saturating=%lld match: "
               "A_div_roundaway_c128=%lld B_mul_round=%lld C_div_trunc=%lld D_clamp127=%lld "
               "E_div_roundeven_c128=%lld of %lld first_bad=%lld\n",
               R, CL, static_cast<double>(sc), sat, mA, mB, mC, mD, mE, tot, first_bad);
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
#endif

