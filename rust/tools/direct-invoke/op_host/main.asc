#include <cstdlib>
#include <cstdio>
#include <string>
// Direct-invoke host entry for one emitted AscendC kernel.
//
// This is the CANN `ASC` language path: one translation unit holds the kernel
// and the host, and the language driver supplies the launch shim. The kernel
// file is copied in as `op_kernel/vec_add_kernel.asc` by `setup.sh` -- it is
// emitter output, never edited.
//
// Everything kernel-specific arrives as a macro from the build: the launcher
// symbol, the extent, the arity, the oracle and its constants. A harness that
// hard-coded any of them would measure one kernel and claim a column.
#include <acl/acl.h>

#include <cmath>
#include <cstdio>
#include <vector>
// STAGE TIMERS, added 2026-11-09 to localise a stall, and KEPT because they found it.
// At the lmhead extents (n = 33,095,680) a run sat 17 minutes at 99.9% host CPU with
// AICore 0% and zero syscalls. Three hypotheses were refuted by measurement first: the
// reference's loop order (fixed; the interchanged form does those extents in 5.2 s
// standalone), bisheng's host codegen (7.51 s at -O0, 2.57 s at -O2, indistinguishable
// from g++), and a device hang (nothing was in flight). Guessing cost three builds.
// These three points BRACKET the stages, so the gaps are the answer: malloc to fills is
// the host fill, fills to ref is the device round trip, ref to exit is the reference. A
// fourth at the launch was dropped because KERNEL_DO has four arity variants and no
// unique anchor, and timing the wrong one would attribute time to a call that never ran.
#include <ctime>
static double di_now() {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return static_cast<double>(ts.tv_sec) + 1e-9 * static_cast<double>(ts.tv_nsec);
}
static double di_t0 = di_now();
#define DI_T(stage) do { \
    fprintf(stderr, "[di-stage] %-22s t=%8.2fs\n", (stage), di_now() - di_t0); \
    fflush(stderr); \
} while (0)


#ifndef KERNEL_DO
#define KERNEL_DO vec_add_do
#endif
#ifndef KERNEL_N
#define KERNEL_N 256
#endif
// The streaming-matvec oracle's own extents. Defaults match the probe kernel; a
// different shape needs them passed as -DMV_N/-DMV_K, which is deliberate -- an
// oracle that inferred them from `n` would be guessing at the kernel's shape.
// ORACLE 44 (embedding row copy) needs the FIRST buffer wider than the output
// row, because the kernel reads row `idx` of a table while the output is one row.
// EMB_ROWS is 4 only for that oracle and 1 for every other, so `EMB_ROWS * bytes`
// is exactly `bytes` everywhere else and no other oracle's allocation moves. It is
// keyed on ORACLE rather than passed in, so `setup.sh` needs no new argument.
//
// It does NOT need the real vocabulary. The kernel's correctness is "copies row
// idx", which is independent of how many rows exist; the vocabulary only bounds
// idx. Four rows of the model's own width is enough, and 2.65 GB of table on a
// board whose HBM is mostly held by a co-tenant is not available anyway.
#ifndef EMB_ROWS
#if ORACLE == 44
#define EMB_ROWS 4
#else
#define EMB_ROWS 1
#endif
#endif

#ifndef MV_N
#define MV_N 64
#endif

// The THIRD extent, for an oracle that needs three (a GEMM: M, K, N). MV_N and MV_K
// carry two; this carries the last. It defaults to 0 and NOTHING ELSE IN THIS FILE
// READS IT, so every existing oracle and every verify_all.sh row passing eleven
// fields or fewer is bit-identical with or without it -- the same inertness EMB_ROWS
// has, and the reason a third extent needs NO change to how buffers are sized. An
// oracle handed MV_P = 0 must REFUSE, never assume a square shape.
#ifndef MV_P
#define MV_P 0
#endif
#ifndef MV_K
#define MV_K 256
#endif

#ifndef KERNEL_REPEAT
// 1 = no timing at all (the historical behaviour, and the default so that a plain
// correctness run pays nothing). Above 1 the launch is repeated and the FIRST is
// discarded: it pays for first-touch of GM and of the UB the allocator carved.
#define KERNEL_REPEAT 1
#endif

#ifndef KERNEL_ARGS
#define KERNEL_ARGS 3
#endif
#ifndef ORACLE
#define ORACLE 0  // 0 = a + b, 1 = rmsnorm, 2 = dot(a,b) into element 0, 3 = silu(a)*b
#endif
#ifndef RMS_EPS
#define RMS_EPS 1e-5f
#endif
#ifndef TOLERANCE
#define TOLERANCE 1e-6
#endif

#include "vec_add_kernel.asc"

#define CHECK(expr)                                                            \
    do {                                                                       \
        auto __r = (expr);                                                     \
        if (__r != ACL_SUCCESS) {                                              \
            printf("FAIL %s -> %d\n", #expr, (int)__r);                        \
            return 1;                                                          \
        }                                                                      \
    } while (0)

int main() {
    const int n = KERNEL_N;

    CHECK(aclInit(nullptr));
    CHECK(aclrtSetDevice(0));
    aclrtContext ctx = nullptr;
    CHECK(aclrtCreateContext(&ctx, 0));
    aclrtStream stream = nullptr;
    CHECK(aclrtCreateStream(&stream));

    const size_t bytes = static_cast<size_t>(n) * sizeof(float);
    // Only buffer 0 may be wider than one row; see EMB_ROWS above.
    const size_t table_bytes = static_cast<size_t>(EMB_ROWS) * bytes;
    void *p0 = nullptr;
    void *p1 = nullptr;
    void *p2 = nullptr;
    void *p3 = nullptr;
    void *p4 = nullptr;
    void *p5 = nullptr;
    void *p6 = nullptr;
    void *p7 = nullptr;
    void *p8 = nullptr;
    CHECK(aclrtMalloc(&p0, table_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&p1, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&p2, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
#if KERNEL_ARGS >= 4
    CHECK(aclrtMalloc(&p3, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
#endif
#if KERNEL_ARGS == 5
    CHECK(aclrtMalloc(&p4, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
#endif
#if KERNEL_ARGS == 9
    // eight inputs + one output: p3 already allocated above, p4..p8 here.
    CHECK(aclrtMalloc(&p4, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&p5, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&p6, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&p7, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&p8, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
#endif
    uint8_t *gm0 = static_cast<uint8_t *>(p0);
    uint8_t *gm1 = static_cast<uint8_t *>(p1);
    uint8_t *gm2 = static_cast<uint8_t *>(p2);

    DI_T("device malloc done");
    std::vector<float> a(static_cast<size_t>(EMB_ROWS) * n), b(n, 0.0f), c(n, 0.0f),
        v(n, 0.0f), s(n, 0.0f);
    std::vector<float> e(n, 0.0f), f(n, 0.0f), g(n, 0.0f), h(n, 0.0f);
    // Values chosen so a row statistic is neither 0 nor 1 and the sign is
    // mixed: an all-positive input hides a sign error in a normalisation.
    for (int i = 0; i < n; ++i) {
        a[i] = static_cast<float>(i) * 0.5f - 3.25f;
        b[i] = static_cast<float>(n - i) * 1.75f + 0.125f;
        if (ORACLE == 58) {
            // MULTI-ROW ARGMAX: a per-row refutation fill. The tie sits at two
            // interior columns in different thirds of EACH row, so a chunk-base
            // error, a `>=` carry and a last-chunk-only answer all give a
            // different index. Rows differ because the background depends on the
            // flat index.
            const int R58 = MV_N, C58 = MV_K;
            const int r58 = i / C58, c58 = i % C58;
            a[i] = static_cast<float>((i * 7919) % 10007) * 0.001f;
            // The tie is SHIFTED PER ROW, so every row's argmax index differs.
            // Without the shift all eight answers are C/3 and a kernel that
            // computed row 0 and broadcast it would pass.
            const int off58 = (r58 * 1237) % C58;
            if (c58 == (C58 / 3 + off58) % C58 || c58 == (2 * C58 / 3 + off58) % C58)
                a[i] = 1000.0f;
        }
        if (ORACLE == 57) {
            // RUNTIME-S attention: S is read from s[0], a test parameter, not a
            // pinned shape. Keep scores O(1) and V non-constant.
            a[i] = static_cast<float>((i * 37) % 101) * 0.002f - 0.1f;
            b[i] = static_cast<float>((i * 53) % 97) * 0.002f - 0.1f;
            v[i] = static_cast<float>((i * 29) % 103) * 0.02f - 1.0f;
        }
        if (ORACLE == 56) {
            // SCALED SINK-FREE ATTENTION needs a NON-DEGENERATE softmax. The
            // default ramps make scores ~1e7, so softmax is one-hot and the
            // output is exactly one V row; and `v` is never filled by default,
            // so an all-zero output would pass. Keep scores O(1) and give V a
            // real, distinct ramp.
            a[i] = static_cast<float>((i * 37) % 101) * 0.002f - 0.1f;
            b[i] = static_cast<float>((i * 53) % 97) * 0.002f - 0.1f;
            v[i] = static_cast<float>((i * 29) % 103) * 0.02f - 1.0f;
        }
        if (ORACLE == 53) {
            // SINK ATTENTION: keep the scaled QK scores O(1) so the sink logit is
            // COMPARABLE to them. The default ramp gives scores ~1e7, where
            // exp(sink-m) underflows to zero and a kernel that silently DROPPED the
            // sink would pass. The sink lanes are DISTINCT (a 0.05 stride), so a
            // reference or kernel that reads one lane for all SB cannot agree.
            a[i] = static_cast<float>((i * 37) % 101) * 0.002f - 0.1f;
            b[i] = static_cast<float>((i * 53) % 97) * 0.002f - 0.1f;
            v[i] = 0.5f - 0.05f * static_cast<float>(i % 8);
        }
        if (ORACLE == 44) {
            // EMBEDDING INPUT, built to refute the three ways a row copy can be
            // wrong while still looking plausible.
            //
            //   * RETURNS ROW 0 WHATEVER THE INDEX. Not hypothetical: it is what an
            //     arm for `__tile_embedding_f32` would have done, because that
            //     intrinsic takes the table as a TILE and the generators could only
            //     ever hand it one row. So the index is 3, not 0, and the row it
            //     selects is the LAST of the four.
            //   * THE RIGHT ROW AT THE WRONG OFFSET -- a stride computed from the
            //     wrong width, which is the one arithmetic step this kernel does.
            //     Every table element is distinct and strictly increasing, so a copy
            //     from any offset other than `idx * n` disagrees at element 0.
            //   * THE INDEX READ FROM THE WRONG ELEMENT. Element 1 of the index
            //     buffer is a DECOY at 0.0f, so reading it instead of element 0
            //     returns row 0, which the first case already fails. A probe of this
            //     kernel really did read element 1; the decoy is there because the
            //     mistake has been made.
            // THE INDEX IS `EMB_ROWS - 1`, NOT A LITERAL 3, as of 2026-11-10. At the
            // default EMB_ROWS 4 that IS 3, so every banked embedding record is
            // unaffected -- the change is inert where it has already been measured.
            // It exists so the index can be driven large, because the three embedding
            // kernels are device-verified at a maximum offset of 3 * 5120 = 15360
            // while every emitted kernel declares `SetGlobalBuffer(..., 16777216)`
            // and the real table is 129280 * 5120 = 661913600 floats -- 39.5x the
            // declared extent. Whether that declaration is advisory or enforced has
            // never been tested, and the lift is the only consumer that wants to prove
            // the access is in range (mlir_to_pto's window check cannot evaluate a
            // runtime offset, and `__tile_load_at_f32` carries the window and the
            // offset but NEVER the parent extent).
            b[i] = (i == 0) ? static_cast<float>(EMB_ROWS - 1) : 0.0f;
        }
        if (ORACLE == 43) {
            // SIGMOID-THEN-TOP-K INPUT, and it is deliberately NOT oracle 42's.
            //
            // Oracle 42's input forces 900.0 and 500.0 to make a tie and a unique
            // maximum. Run through a sigmoid those are both exactly 1.0 -- in f32 and
            // in f64 -- so every forced position ties and the ranks that should
            // discriminate stop discriminating. That is how oracle 42 came to report
            // `wrong=2 first disagreement at rank 0` against a CORRECT kernel: it
            // selected on the raw input while the kernel selects on sigmoid(input),
            // and the kernel's lowest-index-first tie policy was right.
            //
            // So this input stays inside the sigmoid's responsive range. The
            // background spans [-6, +6], where sigmoid runs 0.0025..0.9975 with
            // separations far above f32 epsilon, and the forced values sit ABOVE the
            // background rather than at saturation: 7.0 for the unique maximum
            // (sigmoid 0.99909) and 6.5 twice for the tie (0.99850), against a
            // background ceiling of 0.99753. Every rank then discriminates.
            a[i] = static_cast<float>((i * 7919) % 10007) * 0.0012f - 6.0f;  // [-6, 6.008]
            if (i == n / 4 || i == (3 * n) / 4) a[i] = 6.5f;   // the tie
            if (i == n / 2) a[i] = 7.0f;                       // the unique max
        }
        if (ORACLE == 42) {
            // TOP-K INPUT, built to refute the three ways this can be wrong while
            // still looking plausible.
            //
            //   * A HEAD EXTRACT -- which is exactly what the PTO column's own
            //     fallback does, and its docstring says so: "the stub passthrough,
            //     which is a head extract and not a sort". A monotone or
            //     front-loaded input cannot tell that apart from a selection, so the
            //     background is pseudo-random and its large values land scattered
            //     through the row.
            //   * THE WRONG ONE OF TWO TIED POSITIONS. Two positions are given the
            //     same high value, at n/4 and 3n/4, so the tie policy (lowest index
            //     first) is exercised rather than assumed.
            //   * THE MAXIMUM AT AN END. The unique maximum sits at n/2, interior,
            //     so neither "return index 0" nor "return index n-1" passes.
            a[i] = static_cast<float>((i * 7919) % 10007) * 0.001f;   // [0, 10.007)
            if (i == n / 4 || i == (3 * n) / 4) a[i] = 500.0f;        // the tie
            if (i == n / 2) a[i] = 900.0f;                            // the unique max
        }
        if (ORACLE == 41) {
            // ARGMAX INPUT, built to REFUTE rather than to pass. The default ramp
            // `i*0.5 - 3.25` is monotone, so its argmax is the LAST element and a
            // kernel that always returned n-1 would pass -- which is the trap an
            // argmax oracle is most likely to fall into.
            //
            // Three failure modes have to be refutable, all three specific to a
            // CHUNKED scan:
            //   * forgetting the chunk base, which returns an index modulo the
            //     chunk size;
            //   * carrying the pair with `>=` instead of `>`, which returns the
            //     LAST index attaining the maximum instead of the first;
            //   * keeping only the last chunk's answer, which returns an index in
            //     the final chunk.
            // So: a non-monotone background, and the maximum DELIBERATELY TIED at
            // two interior positions in different thirds of the row. The expected
            // answer is the lower of the two, and each failure mode above gives a
            // different wrong index.
            a[i] = static_cast<float>((i * 7919) % 10007) * 0.001f;   // [0, 10.007)
            if (i == n / 3 || i == (2 * n) / 3) a[i] = 1000.0f;       // the tie
        }
        if (ORACLE == 10) {
            // SiTU's tanh identity `(e^{2z}-1)/(e^{2z}+1)` OVERFLOWS in f32 past
            // |z| ~ 44, i.e. |g| >~ 176 or |u| >~ 1100. The generator's own domain
            // is activations, |g|,|u| <~ 10, so feeding the default ramp (up to
            // 5376) tests OUTSIDE the function's valid domain and reports the
            // overflow rather than the arithmetic. These inputs stay inside it;
            // the limit itself is recorded in the manifests, not hidden here.
            a[i] = (static_cast<float>(i % 37) - 18.0f) * 0.25f;
            b[i] = (static_cast<float>(i % 29) - 14.0f) * 0.5f;
        }
        v[i] = static_cast<float>(i % 7) * 0.25f - 0.5f;
        if (ORACLE == 180) {
  // DEAD: init section, runs before the launch; the live block is after the copy-back.
        // BROADCAST: out[r][c] = a[c], the `col_expand` primitive the engine's flash attention
        // opens with. MV_N is the row count, MV_K the row width.
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        // `col`, not `c`: `c` is the OUTPUT VECTOR in this harness, and shadowing it made
        // `c[r * MV_K + col]` subscript an integer. The compiler caught it; the naming is what
        // invited it.
        for (int r = 0; r < MV_N; ++r) {
            for (int col = 0; col < MV_K; ++col) {
                const double want = static_cast<double>(a[col]);
                const double got = static_cast<double>(c[r * MV_K + col]);
                const double d = std::fabs(got - want);
                abs_sum += d;
                sum_ref += std::fabs(want);
                if (d > max_abs) max_abs = d;
            }
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", MV_N * MV_K, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }
#if ORACLE == 49
    {
        // SIN INPUT, spanning several periods ON PURPOSE. The vendor's adv_api sin is
        // a 4-term Cody-Waite range reduction followed by a degree-9 odd polynomial,
        // so an input confined to one period would exercise the polynomial and never
        // the reduction -- and the reduction is the part that goes wrong far from 0.
        // 0.05 steps from -12.8 give about four periods each side of the origin.
        for (int i = 0; i < n; ++i) {
            a[i] = static_cast<float>(i) * 0.05f - 12.8f;
        }
    }
#endif
    if (ORACLE == 47) {
        // Same never-zero 1..127 int8 ramp as ORACLE 46: a zero byte could not be
        // told from a cleared hold, and the 127 period is coprime with every power
        // of two under test, so a write at the wrong offset disagrees.
        int8_t *a47 = reinterpret_cast<int8_t *>(a.data());
        const size_t n47 = static_cast<size_t>(EMB_ROWS) * static_cast<size_t>(n)
                           * sizeof(float);
        for (size_t k = 0; k < n47; ++k) {
            a47[k] = static_cast<int8_t>((k % 127) + 1);
        }
    }
    if (ORACLE == 46) {
        // NARROW-DTYPE FLOOR PROBE, int8. Packs a distinctive int8 pattern into `a`'s
        // byte storage, following the precedent this file already sets for q8_0
        // weights ("packed into `b` as RAW BYTES").
        //
        // WHY IT HAD TO EXIST. The emitter's partial-block load rule is stated in
        // BYTES, and that is the CONSERVATIVE reading of an f32-only sweep: at f32 a
        // 32-BYTE bound and an 8-ELEMENT bound predict the same verdicts at every
        // extent ever run, because 8 f32 IS 32 bytes. They come apart at a narrow
        // dtype -- 8 int8 is 8 bytes, while 32 bytes is 32 int8 -- and nothing in this
        // harness could express that, because every oracle fills its operands as f32.
        // So the rule the emitter enforces may be four times stricter than the part
        // requires for i8, and no run could tell. This id is the instrument for that
        // one question and nothing else.
        //
        // NEVER ZERO. The pattern cycles 1..127, so every byte is nonzero: a zero byte
        // cannot be distinguished from a cleared hold, which is the value collision
        // that voided a device reading on 2026-11-09. The cycle is 127 rather than 128
        // so the period is coprime with every power of two under test, and a copy that
        // landed at the wrong offset disagrees rather than aliasing.
        int8_t *a_bytes = reinterpret_cast<int8_t *>(a.data());
        const size_t a_nbytes = static_cast<size_t>(EMB_ROWS) * static_cast<size_t>(n)
                                * sizeof(float);
        for (size_t k = 0; k < a_nbytes; ++k) {
            a_bytes[k] = static_cast<int8_t>((k % 127) + 1);
        }
    }
    if (ORACLE == 44) {
        // The TABLE, over all EMB_ROWS rows -- the main loop above only reaches n.
        // Strictly increasing and distinct, so a wrong row or a wrong offset
        // disagrees at the first element compared. 0.25 steps keep every value
        // exactly representable in f32, so the comparison measures the copy and not
        // the rounding.
        for (size_t k = 0; k < static_cast<size_t>(EMB_ROWS) * static_cast<size_t>(n); ++k) {
            a[k] = static_cast<float>(k) * 0.25f + 0.125f;
        }
    }
    // 23..39, not 23..30: oracles 31-33 were added later and fell outside the bound, so they ran the
        // default ramp, overflowed f32 and produced NaN that looked like a kernel fault. The range
        // is deliberately wider than the oracles that exist, so adding one does not reintroduce this.
        if (ORACLE >= 23 && ORACLE <= 39) {
        // Attention inputs are BOUNDED. The default ramp reaches ~1.2e5 across 70,000 elements, so a
        // 64-term dot overflows f32 to inf and `inf - inf` is NaN -- which reads exactly like a
        // broken softmax. An earlier attempt at this block was inserted with the wrong indentation
        // and landed NESTED inside another oracle's body, so it never ran and three rounds of
        // attention bisect used the ramp regardless.
        a[i] = 0.002f * static_cast<float>((i % 7) - 3);
        b[i] = 0.002f * static_cast<float>((i % 11) - 5);
        v[i] = 0.01f * static_cast<float>((i % 5) - 2);
    }
    if (ORACLE == 17) {
            // q8mv: `a` holds int8 weight BYTES and `b` the scale plane. The default ramps give a
            // scale of ~1e7 and byte values of arbitrary garbage, so the dot overflows f32 and the
            // comparison reports chaos rather than arithmetic. Real blocks are ~1e-3.
            // NON-CANCELLING on purpose: with mixed signs the terms sum to ~0, sum|want| collapses,
            // and a backward-error ratio reports 974 on a kernel whose max_abs is 2e-08. The metric
            // needs a denominator that is not the residue of a cancellation.
            reinterpret_cast<signed char *>(a.data())[i] = static_cast<signed char>((i % 17) + 1);
            b[i] = 0.001f;
            v[i] = 1.0f;
        }
        if (ORACLE == 15 && i == 0) {
            // ONCE, not per element. This block packs MV_N*MV_K weights; inside the
            // `for (i < n)` loop it was executed n = 1.2e6 times, i.e. 5e12 inner
            // iterations, and the harness spun at 100% CPU for 25 minutes while I
            // blamed the device kernel -- which had in fact run in 0.077 ms.
            // w8a8: `b` is the int8 weight row (raw bytes), `v` the per-channel scale,
            // `s` the per-channel offset. Deterministic and inside int8 range.
            signed char *wq = reinterpret_cast<signed char *>(b.data());
            for (int r = 0; r < MV_N; ++r) {
                for (int k = 0; k < MV_K; ++k)
                    wq[r * MV_K + k] = static_cast<signed char>(((r * 7 + k * 13) % 255) - 127);
                v[r] = 0.5f / static_cast<float>((r % 7) + 1);
                // Arity 5 binds the fourth input to `s`, not `e`: the harness picks the
                // buffer by ARITY, and this kernel is x, w, scale, offset -> out.
                s[r] = static_cast<float>((r % 5) - 2);
            }
        }
        if (ORACLE == 14) {
            // q8_0 weights packed into `b` as RAW BYTES: per 32 elements a 2-byte half
            // scale (0x3800 = 0.5) then 32 signed int8. `b` holds n floats = 4n bytes,
            // and the probe needs MV_N * (MV_K / 32) * 34 of them.
            unsigned char *bytes = reinterpret_cast<unsigned char *>(b.data());
            for (int r = 0; r < MV_N; ++r) {
                for (int blk = 0; blk < MV_K / 32; ++blk) {
                    unsigned char *p = bytes + ((size_t)r * (MV_K / 32) + blk) * 34;
                    p[0] = 0x00;
                    p[1] = 0x38;  // little-endian f16 0.5
                    for (int q = 0; q < 32; ++q)
                        p[2 + q] = static_cast<unsigned char>(
                            static_cast<signed char>(((r + blk + q) % 17) - 8));
                }
            }
        }
        if (ORACLE == 12) {
            // rope halves: b is cos and v is sin, so they must stay in [-1, 1].
            // The default ramps reach ~1e2, which is outside any angle's cosine and
            // would test the oracle rather than the kernel.
            b[i] = static_cast<float>(cos(0.1 * i));
            v[i] = static_cast<float>(sin(0.1 * i));
        }
        if (ORACLE == 8) {
            // The fused gate/up is silu(x*wg)*(x*wu). At n = 16384 the default
            // ramp reaches |x*wg| ~ 1e6, where silu is no longer an activation and
            // the f64 oracle leaves the f32 range -- the same domain mistake the
            // SiTU oracle made, at a different oracle. Keep the operands inside
            // the function's domain and say so here.
            a[i] = (static_cast<float>(i % 37) - 18.0f) * 0.125f;
            b[i] = (static_cast<float>(i % 29) - 14.0f) * 0.25f;
            v[i] = (static_cast<float>(i % 23) - 11.0f) * 0.5f;
        }
        e[i] = static_cast<float>(i % 11) * 0.5f - 2.5f;
        f[i] = static_cast<float>(i % 13) * 0.25f - 1.5f;
        g[i] = static_cast<float>(i % 17) * 0.125f - 1.0f;
        h[i] = static_cast<float>(i % 19) * 0.0625f - 0.5f;
        s[i] = static_cast<float>(i % 5) * 0.75f + 0.125f;
    }
    // REAL INPUTS FROM DISK, when DS4_IN_DIR is set: a.bin/b.bin/v.bin/s.bin each hold `n`

    // HOISTED OUT OF THE PER-ELEMENT FILL LOOP, 2026-11-09. This block fills the WHOLE
    // A and B arrays, so it belongs beside that loop, not inside it. The other oracles'
    // init blocks sit inside legitimately -- they are per-element, assigning a-sub-i and
    // b-sub-i. This one is not, and placing it there made it run n times.
    //
    // WHAT THAT COST, AND WHY NO CORRECTNESS CHECK COULD CATCH IT. Nested, the work was
    // O of n times M*K plus K*N. At the calibration shape, M=4 K=8 N=4 with n=32, that
    // is 2048 iterations -- instant -- and because the fill is IDEMPOTENT, writing
    // identical values on every pass, the oracle gave CORRECT RESULTS and passed BOTH
    // its positive and its negative arm with the defect present. At the lmhead shape,
    // M=16 K=5120 N=12928 with n=33,095,680, the same code is 2.2e15 iterations; two
    // runs sat 17 and 2 minutes at 99.9% host CPU and would never have finished. The bug
    // changed only TIME, and only at a scale no calibration had reached, so no gate on
    // VALUES could see it however adversarial its inputs were.
    //
    // Found with the stage timers above, after three hypotheses had each been refuted by
    // measurement, and confirmed by a BRACE-DEPTH WALK rather than by reading the
    // indentation -- the block looked top-level, which is why it survived being written.
    // The first hoist attempt took the first four-space closing brace after the block as
    // the loop end and moved it to another spot still inside: the walk is the authority,
    // never the layout. The second attempt put a brace character inside THIS comment,
    // which the walk then counted as code. Prose about braces does not contain braces.
#if ORACLE == 52
    if (1) {  // compile-time gated; BESIDE the per-element loop, not inside it
        // i32 TWO-TILE MAX INPUT, for rule `tmax-hardware-symmetry`: "the part's TMAX
        // is element-wise and symmetric in operand order on i32 tiles". Space is
        // dtype {i32} x width {8} x value {ramp, mixed-sign} x order {source, swapped},
        // and BOTH `order=swapped` and `value=mixed-sign` are declared refutation
        // classes -- a universal claim passes only with a class that could have
        // refuted it, so confirmations alone would be UNSOUND-BY-DIRECTION.
        //
        // The ORDER class lives in the probe's `.pto` (two hand-written files whose
        // assembled output differs in exactly one line, `TMAX(v37, v21, v35)` against
        // `TMAX(v37, v35, v21)` -- same opcode, same destination). The VALUE class
        // lives here, selected by MV_N: 0 = ramp, 1 = mixed-sign.
        //
        // WHY A PROBE AT ALL: no corpus kernel emits `pto.tmax`. Zero occurrences
        // across every stored .pto, which only ever emits the tile-by-SCALAR
        // `pto.tmaxs`. So this is a universal claim about an operation the corpus does
        // not use, and it had an EMPTY evidence list -- NOT-RUN rather than passing on
        // the two instruction-layer rows its predecessor carried, which cannot speak
        // for the hardware.
        //
        // MIXED-SIGN IS THE REFUTER AND IS BUILT TO BE ONE. Values straddle zero with
        // both operands taking each side at different lanes, so a TMAX that compared
        // magnitudes, or compared unsigned, or returned its first operand, disagrees
        // somewhere. A ramp where a > b everywhere would be satisfied by "return the
        // larger operand slot" and refute nothing.
        int32_t *ai = reinterpret_cast<int32_t *>(a.data());
        int32_t *bi = reinterpret_cast<int32_t *>(b.data());
        for (int i = 0; i < 8; ++i) {
            if (MV_N == 0) {
                ai[i] = i;            // ramp: a rises, b falls, so the max switches
                bi[i] = 7 - i;        // operand slot halfway along
            } else {
                // mixed-sign: each operand is positive at some lanes and negative at
                // others, and the winner alternates between the two slots.
                ai[i] = ((i % 2) == 0 ? 1 : -1) * (i + 1) * 3;
                bi[i] = ((i % 3) == 0 ? -1 : 1) * (8 - i) * 2;
            }
        }
    }
#endif

#if ORACLE == 51
    if (1) {  // compile-time gated; BESIDE the per-element loop, not inside it
        // f32 -> i8 QUANTIZE INPUT, for `__tile_quantize_f32_i8`. Signature read from
        // bench/deepseek_v41/tile/quant_i8_v41_8x5120.tile:
        //   arg0 = x, R x CL f32    arg1 = scale, loaded as __tile_load_f32(arg1,1,1)
        //   arg2 = out, R x CL i8
        // So this kernel's scale is ONE f32 SCALAR -- unlike the i8 GEMM's arg3, which
        // is a GM pointer and therefore a per-column TENSOR. Two different operands,
        // and conflating them is what made "what is scale" look like three answers.
        // The output is the LAST argument here, so this kernel IS drivable by the
        // harness, whose copy-back is arity-keyed (3 -> gm2) -- the i8 GEMM is not.
        //
        // THE CONVENTION IS UNKNOWN AND THIS FILL IS BUILT TO IDENTIFY IT, not to
        // assume it. Four readings are all in real use:
        //     A  q = round(x / s)        s is the step size          <- scored
        //     B  q = round(x * s)        s is the reciprocal step
        //     C  truncate toward zero instead of round-to-nearest
        //     D  clamp to [-128, 127] instead of [-127, 127]
        // Picking one and reporting FAIL would say nothing about which the kernel
        // implements. So the scoring block counts matches for ALL FOUR and prints
        // them: a run identifies the convention instead of merely rejecting one.
        // That is the probe-not-retry rule -- two outcomes that both read as "wrong"
        // are one outcome.
        //
        // TWO REGIMES, deliberately, with the counts computed before this was written:
        //   * the bulk (|x| <= 30, steps of 0.25) stays inside the i8 range under A,
        //     so the ARITHMETIC is what is tested. 0.25 steps put x/s exactly on .5
        //     cases, which is what separates round-to-nearest from truncation.
        //   * one column in 97 saturates (|x| up to 270), so the CLAMP is tested
        //     WITHOUT swamping everything else. A first design let |x| reach 127.5,
        //     which saturated HALF the elements and masked the arithmetic entirely.
        //
        // MEASURED DISCRIMINATION at R=8 CL=5120 s=0.5, elements differing from A:
        //     A vs B (multiply vs divide)   40613 / 40960   99.2%
        //     A vs C (round vs truncate)    20178 / 40960   49.3%
        //     A vs D (clamp bound)            182 / 40960    0.44%
        // Saturating under A: 364 / 40960 (0.9%), down from 50%. The output is
        // INTEGER, so the gate is EXACT and 182 differing elements is decisive.
        //
        // KNOWN BOUND: x depends on c through c*13 % 241, so a column shift by a
        // multiple of 241 is invisible. A row-stride error shifts by CL = 5120, and
        // 5120 % 241 = 59, so that IS visible; the elementwise errors this op can
        // produce are per-element rather than column shifts.
        const long long o51_R = MV_N, o51_CL = MV_K;
        if (o51_R > 0 && o51_CL > 0
            && o51_R * o51_CL <= static_cast<long long>(n)) {
            float *xf = a.data();
            for (long long r = 0; r < o51_R; ++r) {
                for (long long cc = 0; cc < o51_CL; ++cc) {
                    const long long idx = r * o51_CL + cc;
                    xf[idx] = (cc % 97 == 0)
                        ? static_cast<float>((((r * 5 + cc * 3) % 7) - 3)) * 90.0f
                        : static_cast<float>((((r * 37 + cc * 13) % 241) - 120)) * 0.25f;
                }
            }
            b.data()[0] = 0.5f;   // the 1x1 scale tile
        }
    }
#endif

#if ORACLE == 50 || ORACLE == 54
    if (1) {  // compile-time gated; placed BESIDE the per-element loop, not inside it
        // i8 GEMM INPUT with a PER-COLUMN f32 SCALE, for
        // `__tile_matmul_i8_acc_i32_dequant_f16`. Operand order read from
        // bench/deepseek_v41/tile/gemm_i8_v41_16x5120x2304.tile:
        //   arg0 = A, M x K i8      arg1 = B, K x N i8
        //   arg2 = out, M x N f16   arg3 = scale, a GM POINTER (a per-column TENSOR)
        // So `scale` is a TENSOR here. The sibling kernel quant_i8_v41_8x5120 loads
        // its scale as `__tile_load_f32(%arg1, 1, 1)` -- a 1x1 tile, ONE f32. Two
        // different operands; treating them as one is what made "what is scale" look
        // like three conflicting answers when it was two different questions.
        //
        // THE FILL WAS DERIVED BY COMPUTATION, NOT CHOSEN. Five candidates were
        // scored offline against five failure modes before this was written, because
        // ORACLE 48's fill was ASSERTED and carried two defects nobody saw for a day.
        // What the iterations found, each a fault in the previous candidate:
        //
        //  1. A PERIOD THAT DIVIDES K CANCELS EXACTLY. `% 5` over K = 5120 = 2^10*5
        //     is 1024 whole periods of a zero-mean pattern: the accumulator came out
        //     0..26 WITH EXACT ZEROS, which makes a relative gate meaningless. Both
        //     moduli below leave a remainder: 5120 % 13 = 11, 5120 % 11 = 3.
        //  2. A MULTIPLIER SHARING A FACTOR WITH ITS MODULUS kills the dependence.
        //     `(k*5 + n*11) % 11` makes B INDEPENDENT OF n, because n*11 % 11 == 0,
        //     and a B-column error then scores EXACTLY ZERO. Every (multiplier,
        //     modulus) pair here is checked coprime: (3,13), (7,11), (37,2309).
        //  3. A LARGE ACCUMULATOR IS THE WRONG INSTINCT. With non-zero-mean terms
        //     acc ~ K*mean(A)*mean(B) dominates, the n-dependent part is a ~1%
        //     perturbation, and a transpose or column shift lands near 3e-3 relative
        //     -- at or under f16's floor. ZERO-MEAN terms make the accumulator
        //     STRUCTURE-dominated and every structural error an O(1) relative change.
        //     ORACLE 48's accidental cancellation was not a flaw; it is the property
        //     that made it sensitive, which is the opposite of what I first wrote.
        //  4. THE SCALE IS THE DEGENERACY KILLER. C[m][n] = acc[m][n] * scale[n], so
        //     a strictly distinct scale per column gives distinct expected values
        //     even where acc repeats -- the fix for ORACLE 48's 272-value collapse.
        //     It is scrambled by *37 (coprime with 2309) so ADJACENT columns differ
        //     by ~3% instead of 1 part in 2300, which is what lifts a scale read one
        //     column over from 8.7e-4 (marginal) to 3.2e-2 (unambiguous).
        //
        // MEASURED SENSITIVITY of the fill below, median relative change against an
        // f16 round-trip floor of 4.88e-04, at M=16 K=5120 N=2304:
        //
        //     scale read one column over    3.24e-02      66x the floor
        //     one k dropped                 1.27e-01     260x
        //     a 256-wide K block dropped    1.10e+00    2250x
        //     B column group off by 16      1.02e+00    2090x
        //     B transposed                  1.08e+00    2210x
        //
        // ALL FIVE detectable. Designs 2 and 4 put "one k dropped" at 3.9e-04, BELOW
        // the floor, and were marginal on transpose -- so this is a property of the
        // chosen fill and not of i8 GEMMs. |C| spans 0.0078 .. 1641.6 with no zeros,
        // 70.7% of the 36864 outputs are distinct, and the i32 accumulation is EXACT
        // (|acc| <= 182, far inside int32).
        const long long o50_M = MV_N, o50_K = MV_K, o50_N = MV_P;
        const long long o50_nb = static_cast<long long>(n) * sizeof(float);
        if (o50_M > 0 && o50_K > 0 && o50_N > 0
            && o50_M * o50_K <= o50_nb && o50_K * o50_N <= o50_nb
            && o50_N * 4 <= o50_nb) {
            int8_t *a8 = reinterpret_cast<int8_t *>(a.data());
            int8_t *b8 = reinterpret_cast<int8_t *>(b.data());
            float *sc = s.data();
            for (long long m = 0; m < o50_M; ++m)
                for (long long k = 0; k < o50_K; ++k)
                    a8[m * o50_K + k] =
                        static_cast<int8_t>(((m * 7 + k * 3) % 13) - 6);
            for (long long k = 0; k < o50_K; ++k)
                for (long long nn = 0; nn < o50_N; ++nn)
                    b8[k * o50_N + nn] =
                        static_cast<int8_t>(((k * 5 + nn * 7) % 11) - 5);
            for (long long nn = 0; nn < o50_N; ++nn)
                sc[nn] = static_cast<float>(1 + ((nn * 37) % 2309)) * 0.00390625f;
        }
    }
#endif

#if ORACLE == 48
    if (1) {  // compile-time gated above
        // GEMM INPUT, PACKED AS f16. Every matmul kernel in this corpus loads
        // `__tile_load_f16` or `__tile_load_i8`; the only `__tile_matmul_f32` users
        // are the two attn_sink kernels, which load through `__tile_load_at_f32` and
        // are scored by ORACLE 23. So an f32 fill here had NO TARGET: an f16 kernel
        // would read the float bytes as pairs of halves and compute garbage against
        // a reference that was itself correct. Packing halves is the fix, and the
        // reference below reads back exactly the halves written here.
        //
        // A is M x K halves at the start of `a`; B is K x N halves at the start of
        // `b`. Both are prefixes of buffers the harness sizes in FLOATS, so a half
        // prefix needs half the elements -- the refusal below computes that in bytes.
        //
        // BUILT TO REFUTE A BLOCKED CUBE ARM'S FAILURE MODES rather than merely to
        // be non-zero. Values depend on BOTH indices and are NON-SYMMETRIC in k and
        // n, so: a dropped K-block leaves C low by that block's contribution; an
        // N-block written at the wrong column offset disagrees everywhere, because
        // no two columns of B are equal; a transposed B disagrees, because
        // B[k][n] != B[n][k]; and an accumulator initialised on the SECOND block
        // instead of the first -- the cmatrixInitVal true-then-false split the
        // stored lmhead plan uses -- keeps only the last block and is far off.
        //
        // Magnitudes are small and EXACTLY REPRESENTABLE IN f16: multiples of 0.125
        // and 0.0625 within [-0.75, 0.75], so the pack is lossless and the test
        // measures the matmul rather than the f32->f16 rounding.
        //
        // CORRECTED 2026-11-09. This comment previously said "At K = 5120 the largest
        // |C| is about 1920". That was an ESTIMATE, never computed, and it is wrong by
        // about 1140x: the true range at K = 5120 is |C| in 0.0078 .. 1.6797. The
        // estimate assumed random-walk growth over 5120 terms; the fill's terms have
        // near-zero mean and a short period, so they CANCEL instead of accumulating.
        //
        // That error propagated into a claim about the oracle's SENSITIVITY which was
        // also wrong, and in the conservative-sounding direction, which is why it went
        // unchallenged. The claim was that at K = 5120 a single dropped k costs ~2e-4
        // relative, below f16's floor at |C| ~ 1920, so this oracle could detect a
        // dropped K-BLOCK but not a single dropped k. Recomputed against the real
        // magnitudes: f16's relative floor near |C| = 1.68 is ~5.8e-4, while dropping
        // one k moves |C| by a MEDIAN of 0.142 relative (worst case 48x). So a single
        // dropped k is detectable here by two to three orders of margin. The oracle is
        // far more sensitive at lmhead scale than it was documented to be.
        //
        // THE REAL LIMITATION IS A DIFFERENT ONE, and it is structural rather than
        // numeric. A[m][k] depends on k mod 13 and B[k][n] depends on k mod 17 -- so
        // for a fixed m, C[m][n] depends on n ONLY through n mod 17. At N = 12928 that
        // is 16 x 17 = 272 DISTINCT EXPECTED VALUES, each repeated about 760 times,
        // not 206848 independent ones. Verified by direct computation on 300 random
        // (m, n) probes against the (m, n mod 17) table: zero disagreements.
        //
        // What that costs, stated so a PASS is not over-read: a column-placement error
        // that shifts n by any MULTIPLE OF 17 is INVISIBLE to this fill. A shift by 16
        // -- the group width -- is visible, since 16 and 17 are coprime, and so is any
        // shift not divisible by 17. But a whole-group misplacement by 17, 34, ...
        // columns scores clean. Fixing it means giving B a long period in n, which
        // changes every recorded reading, so it is NOT being changed while banking runs
        // are in flight; it is declared here instead. The 272 values ARE all exactly
        // f16-representable, which is why max_abs = 0.000e+00 is a legitimate result
        // and not a sign of a dead comparison.
        const long long o48_M = MV_N, o48_K = MV_K, o48_N = MV_P;
        const long long o48_nb = static_cast<long long>(n) * sizeof(float);
        if (o48_M > 0 && o48_K > 0 && o48_N > 0
            && o48_M * o48_K * 2 <= o48_nb && o48_K * o48_N * 2 <= o48_nb) {
            __fp16 *ah = reinterpret_cast<__fp16 *>(a.data());
            __fp16 *bh = reinterpret_cast<__fp16 *>(b.data());
            for (long long m = 0; m < o48_M; ++m)
                for (long long k = 0; k < o48_K; ++k)
                    ah[m * o48_K + k] =
                        static_cast<__fp16>(static_cast<float>(((m * 7 + k * 3) % 13) - 6)
                                            * 0.125f);
            for (long long k = 0; k < o48_K; ++k)
                for (long long nn = 0; nn < o48_N; ++nn)
                    bh[k * o48_N + nn] =
                        static_cast<__fp16>(static_cast<float>(((k * 5 + nn * 11) % 17) - 8)
                                            * 0.0625f);
        }
    }
#endif
    // floats. This is what lets the harness verify a CERTIFIED kernel against real model
    // bytes rather than synthetic ones -- the gap between "the kernel matches its oracle on
    // made-up data" and "the kernel matches the host on the deployment package".
    if (const char *in_dir = std::getenv("DS4_IN_DIR")) {
        auto slurp = [&](const char *name, std::vector<float> &dst) {
            std::string p = std::string(in_dir) + "/" + name;
            FILE *fp = std::fopen(p.c_str(), "rb");
            if (!fp) return false;
            const size_t got = std::fread(dst.data(), sizeof(float), dst.size(), fp);
            std::fclose(fp);
            return got == dst.size();
        };
        bool ok = true;
        ok &= slurp("a.bin", a);
#if KERNEL_ARGS != 2
        ok &= slurp("b.bin", b);
#endif
#if KERNEL_ARGS >= 4
        ok &= slurp("v.bin", v);
#endif
#if KERNEL_ARGS == 5
        ok &= slurp("s.bin", s);
#endif
        if (!ok) {
            std::fprintf(stderr, "DS4_IN_DIR=%s: an input file is missing or the wrong size\n", in_dir);
        }
    }

    DI_T("fills done, h2d");
    // RUNTIME-S attention: set the launch's S AFTER the fill loop. The loop's
    // own scratch fill writes s[i], so an in-loop assignment is overwritten.
    if (ORACLE == 57) s[0] = static_cast<float>(MV_N);
    if (ORACLE == 59) {
        // PACKED MXFP4 matvec: W is ne0*npair*32 BYTES (n floats = 4n bytes,
        // exactly the packed size), d is ne0*nb HALVED scales, x is the
        // concatenated even/odd activation planes. Fill from the same contract
        // `mxfp4_repack::matvec_ref` uses.
        uint8_t *ab59 = reinterpret_cast<uint8_t *>(a.data());
        for (long long i = 0; i < static_cast<long long>(n) * 4; ++i)
            ab59[i] = static_cast<uint8_t>((i * 37) & 0xFF);
        for (int i = 0; i < 2304 * 160; ++i) b[i] = 0.5f + static_cast<float>(i % 7) * 0.25f;
        for (int i = 0; i < 5120; ++i) v[i] = static_cast<float>((i * 29) % 101) * 0.01f - 0.5f;
    }
    CHECK(aclrtMemcpy(gm0, table_bytes, a.data(), table_bytes, ACL_MEMCPY_HOST_TO_DEVICE));
#if KERNEL_ARGS != 2
    // ANY arity above 2 has a second input. This guard used to read `== 3`, so a
    // FIVE-argument kernel ran with `k` never copied: `q.k` was zero, the whole
    // beta*(q.k)*v term vanished, and the kernel was blamed for a harness bug.
    // The symptom was exact -- got == 0.5*s to the last digit -- which is what
    // sent the search into the emitter when the fault was here.
    CHECK(aclrtMemcpy(gm1, bytes, b.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
#endif
    // EVERY input the arity declares, selected by the ARITY rather than by a
    // remembered case. This file has now had the same bug twice -- `b` copied
    // only for ARGS==3 (so a five-argument kernel ran with k = 0 and a whole
    // term vanished) and `v` copied only for ARGS==5 (so a four-argument kernel
    // ran with wu = 0). Each produced a convincing "the emitter drops a term"
    // symptom. The arity is the only fact this file should branch on.
#if KERNEL_ARGS >= 4
    CHECK(aclrtMemcpy(gm2, bytes, v.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
#endif
#if KERNEL_ARGS == 5
    CHECK(aclrtMemcpy(p3, bytes, s.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
#endif
#if ORACLE == 47
    // THE GUARD REGION. ORACLE 47 asks whether a sub-block `DataCopyPad` STORE
    // writes OUTSIDE the extent it was handed. Two reasons that needs the harness
    // rather than a kernel-side check:
    //   * the destination must hold something RECOGNISABLE first, or a write past
    //     the extent cannot be told from whatever was already there;
    //   * it cannot be bounded by the kernel's own view -- every emitted kernel
    //     declares `SetGlobalBuffer(..., 16777216)` whatever the real aclrtMalloc
    //     is, so an overrun is invisible to `GlobalTensor` at all 379 stored sites.
    // So the whole output buffer is filled with a sentinel here and inspected past
    // the written extent below. 0xA5 is neither 0 (what a cleared hold reads as)
    // nor any byte of the 1..127 source ramp, so all three are distinguishable.
    {
        std::vector<uint8_t> guard(bytes, 0xA5);
        CHECK(aclrtMemcpy(gm1, bytes, guard.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }
#endif
#if KERNEL_ARGS == 9
    // x0=a, x1=b (gm0/gm1), x2=v (gm2), x3=e (p3); w0..w3 = f,g,h,s (p4..p7).
    //
    // p3 is filled HERE and not by the `== 5` branch above, which is the branch
    // that fills p3 for a five-argument kernel. Missing this left x3 as freshly
    // allocated zeros, and the diagnostic was beautiful: the output was short by
    // exactly one product, -0.3125 = x3*w3 with x3 = 0.
    CHECK(aclrtMemcpy(p3, bytes, e.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(p4, bytes, f.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(p5, bytes, g.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(p6, bytes, h.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(p7, bytes, s.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
#endif

    // The arity is a property of the kernel's signature, so it has to be a
    // preprocessor split: a runtime `if` compiles both calls and the wrong-arity
    // one does not resolve.
#if KERNEL_ARGS == 9
    // eight inputs then the output: (x0..x3, w0..w3) -> o
    KERNEL_DO(1, stream, gm0, gm1, gm2, static_cast<uint8_t *>(p3),
              static_cast<uint8_t *>(p4), static_cast<uint8_t *>(p5),
              static_cast<uint8_t *>(p6), static_cast<uint8_t *>(p7),
              static_cast<uint8_t *>(p8));
#elif KERNEL_ARGS == 4
    // three inputs then the output: (x, wg, wu) -> o
    KERNEL_DO(1, stream, gm0, gm1, gm2, static_cast<uint8_t *>(p3));
#elif KERNEL_ARGS == 5
    // 4 inputs then the output: (q, k, v, s) -> o
    KERNEL_DO(1, stream, gm0, gm1, gm2, static_cast<uint8_t *>(p3),
              static_cast<uint8_t *>(p4));
#elif KERNEL_ARGS == 3
    KERNEL_DO(1, stream, gm0, gm1, gm2);
#else
    KERNEL_DO(1, stream, gm0, gm1);  // two-argument: (in, out)
#endif
    CHECK(aclrtSynchronizeStream(stream));

    // TIMING. The harness used to report correctness only -- no clock, no event, no
    // duration anywhere -- so no question of the form "is this emission faster" could be
    // answered with it. One event pair around the launch that already exists, plus a
    // repeat so a single launch's noise cannot pass for a result.
    //
    // The first launch is excluded from the average: it pays for the kernel's own
    // first-touch of GM and of the UB the allocator carved, and including it made short
    // kernels look 3x slower than they are on the box this was first measured on.
#if KERNEL_REPEAT > 1
    {
      aclrtEvent ev_start = nullptr, ev_end = nullptr;
      CHECK(aclrtCreateEvent(&ev_start));
      CHECK(aclrtCreateEvent(&ev_end));
      double total_ms = 0.0;
      for (int rep = 0; rep < KERNEL_REPEAT; ++rep) {
#if KERNEL_ARGS == 9
        CHECK(aclrtRecordEvent(ev_start, stream));
        KERNEL_DO(1, stream, gm0, gm1, gm2, static_cast<uint8_t *>(p3),
                  static_cast<uint8_t *>(p4), static_cast<uint8_t *>(p5),
                  static_cast<uint8_t *>(p6), static_cast<uint8_t *>(p7),
                  static_cast<uint8_t *>(p8));
        CHECK(aclrtRecordEvent(ev_end, stream));
#elif KERNEL_ARGS == 4
        CHECK(aclrtRecordEvent(ev_start, stream));
        KERNEL_DO(1, stream, gm0, gm1, gm2, static_cast<uint8_t *>(p3));
        CHECK(aclrtRecordEvent(ev_end, stream));
#elif KERNEL_ARGS == 5
        CHECK(aclrtRecordEvent(ev_start, stream));
        KERNEL_DO(1, stream, gm0, gm1, gm2, static_cast<uint8_t *>(p3),
                  static_cast<uint8_t *>(p4));
        CHECK(aclrtRecordEvent(ev_end, stream));
#elif KERNEL_ARGS == 3
        CHECK(aclrtRecordEvent(ev_start, stream));
        KERNEL_DO(1, stream, gm0, gm1, gm2);
        CHECK(aclrtRecordEvent(ev_end, stream));
#else
        CHECK(aclrtRecordEvent(ev_start, stream));
        KERNEL_DO(1, stream, gm0, gm1);
        CHECK(aclrtRecordEvent(ev_end, stream));
#endif
        CHECK(aclrtSynchronizeStream(stream));
        if (rep > 0) {
          float ms = 0.0f;
          CHECK(aclrtEventElapsedTime(&ms, ev_start, ev_end));
          total_ms += ms;
        }
      }
      printf("TIME_MS %.6f\n", total_ms / static_cast<double>(KERNEL_REPEAT - 1));
      CHECK(aclrtDestroyEvent(ev_start));
      CHECK(aclrtDestroyEvent(ev_end));
    }
#endif
#if KERNEL_ARGS == 9
    CHECK(aclrtMemcpy(c.data(), bytes, p8, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
#elif KERNEL_ARGS == 4
    CHECK(aclrtMemcpy(c.data(), bytes, p3, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
#elif KERNEL_ARGS == 5
    CHECK(aclrtMemcpy(c.data(), bytes, p4, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
#elif KERNEL_ARGS == 3
    CHECK(aclrtMemcpy(c.data(), bytes, gm2, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
#else
    CHECK(aclrtMemcpy(c.data(), bytes, gm1, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
#endif

    // ORACLE 1: y = x / sqrt(mean(x^2) + eps), the definition the emitted
    // kernel implements. Accumulated in f64 so the comparison is against the
    // real-valued answer rounded once, not against a second f32 accumulation.
    double mean_sq = 0.0;
    for (int i = 0; i < n; ++i) {
        mean_sq += static_cast<double>(a[i]) * static_cast<double>(a[i]);
    }
    mean_sq /= n;
    const double rms_denom = std::sqrt(mean_sq + static_cast<double>(RMS_EPS));

    double max_abs = 0.0, max_rel = 0.0;
    int wrong = 0;
    if (ORACLE == 44) {
        // out[0, col] = table[idx, col]. The index comes from `b[0]`, read exactly
        // as the kernel reads it, rather than from the literal 3: if the input block
        // above is ever changed the reference follows it instead of drifting.
        const int idx = static_cast<int>(b[0]);
        for (int col = 0; col < n; ++col) {
            const double want =
                static_cast<double>(a[static_cast<size_t>(idx) * static_cast<size_t>(n) + col]);
            const double d = std::fabs(static_cast<double>(c[col]) - want);
            const double ref = std::fabs(want) > 1e-12 ? std::fabs(want) : 1.0;
            if (d > max_abs) max_abs = d;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e idx=%d rows=%d\n",
               n, wrong, max_abs, max_rel, idx, EMB_ROWS);
        // WHERE, not just how many. A copy that lands on the wrong ROW is wrong in
        // every element and a count cannot tell that from a wrong offset inside the
        // right row. The first disagreement with both values separates them: a wrong
        // row shows a value from a different multiple of n, a wrong offset shows a
        // neighbour.
        for (int col = 0; col < n; ++col) {
            const double want =
                static_cast<double>(a[static_cast<size_t>(idx) * static_cast<size_t>(n) + col]);
            const double ref = std::fabs(want) > 1e-12 ? std::fabs(want) : 1.0;
            if (std::fabs(static_cast<double>(c[col]) - want) / ref > TOLERANCE) {
                printf("  first disagreement at col %d: got %.6f want %.6f\n",
                       col, static_cast<double>(c[col]), want);
                break;
            }
        }
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (ORACLE == 10) {
        // SiTU, from the generator's own definition:
        //   situ(g,u) = b*tanh(g/b)*sigmoid(g) * b_lin*tanh(u/b_lin)
        // with the K3 config's betas (4.0 and 25.0), which the kernel folds in.
        const double beta = 4.0, beta_lin = 25.0;
        for (int i = 0; i < n; ++i) {
            const double g = static_cast<double>(a[i]);
            const double u = static_cast<double>(b[i]);
            const double want = beta * std::tanh(g / beta) * (1.0 / (1.0 + std::exp(-g)))
                              * (beta_lin * std::tanh(u / beta_lin));
            const double d = std::fabs(static_cast<double>(c[i]) - want);
            const double ref = std::fabs(want) > 1e-12 ? std::fabs(want) : 1.0;
            if (d > max_abs) max_abs = d;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, wrong, max_abs, max_rel);
        // WHERE, not just how many. A count cannot distinguish "half the output is
        // unwritten" from "every chunk computed the wrong thing", and those have
        // different causes. First and last mismatch, with the values.
        {
            int first = -1, last = -1;
            for (int i = 0; i < n; ++i) {
                const double gv = static_cast<double>(a[i]);
                const double uv = static_cast<double>(b[i]);
                const double want = 4.0 * std::tanh(gv / 4.0) * (1.0 / (1.0 + std::exp(-gv)))
                                  * (25.0 * std::tanh(uv / 25.0));
                const double ref = std::fabs(want) > 1e-12 ? std::fabs(want) : 1.0;
                if (std::fabs(static_cast<double>(c[i]) - want) / ref > TOLERANCE) {
                    if (first < 0) first = i;
                    last = i;
                }
            }
            if (first >= 0) {
                printf("first mismatch at %d: got %0.6e want %0.6e\n", first,
                       static_cast<double>(c[first]),
                       4.0 * std::tanh(static_cast<double>(a[first]) / 4.0)
                           * (1.0 / (1.0 + std::exp(-static_cast<double>(a[first]))))
                           * (25.0 * std::tanh(static_cast<double>(b[first]) / 25.0)));
                printf("last mismatch at %d of %d\n", last, n);
            }
        }
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (ORACLE == 8) {
        // The fused gate/up: g = x*wg, u = x*wu, out = silu(g) * u.
        for (int i = 0; i < n; ++i) {
            const double g = static_cast<double>(a[i]) * static_cast<double>(b[i]);
            const double u = static_cast<double>(a[i]) * static_cast<double>(v[i]);
            const double want = (g / (1.0 + std::exp(-g))) * u;
            const double d = std::fabs(static_cast<double>(c[i]) - want);
            const double ref = std::fabs(want) > 1e-12 ? std::fabs(want) : 1.0;
            if (d > max_abs) max_abs = d;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, wrong, max_abs, max_rel);
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2); aclrtFree(p3);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (ORACLE == 7) {
        // sum(a[i]*b[i]) broadcast: the delta-net's dot product, two distinct loads.
        double sum = 0.0;
        for (int i = 0; i < n; ++i) sum += static_cast<double>(a[i]) * static_cast<double>(b[i]);
        for (int i = 0; i < n; ++i) {
            const double d = std::fabs(static_cast<double>(c[i]) - sum);
            if (d > max_abs) max_abs = d;
            const double ref = std::fabs(sum) > 1e-12 ? std::fabs(sum) : 1.0;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, wrong, max_abs, max_rel);
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (ORACLE == 6) {
        // sum(a[i]^2) broadcast: the same primitive with a COMPUTED source,
        // which is the shape the delta-net's reduce takes.
        double sum = 0.0;
        for (int i = 0; i < n; ++i) sum += static_cast<double>(a[i]) * static_cast<double>(a[i]);
        for (int i = 0; i < n; ++i) {
            const double d = std::fabs(static_cast<double>(c[i]) - sum);
            if (d > max_abs) max_abs = d;
            const double ref = std::fabs(sum) > 1e-12 ? std::fabs(sum) : 1.0;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, wrong, max_abs, max_rel);
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (ORACLE == 9) {
        // DUMP: print the inputs, the scalar the kernel should broadcast, and the
        // first outputs. One run, and the arithmetic decides which term is wrong
        // -- cheaper than three probe kernels and no less conclusive.
        double qk = 0.0;
        for (int j = 0; j < n; ++j) qk += static_cast<double>(a[j]) * static_cast<double>(b[j]);
        printf("q=%0.6e %0.6e  k=%0.6e %0.6e  v=%0.6e %0.6e  s=%0.6e %0.6e\n",
               a[0], a[1], b[0], b[1], v[0], v[1], s[0], s[1]);
        printf("qk=%0.9e   (0.5*s + qk*v)[0]=%0.9e  got[0]=%0.9e\n",
               qk, 0.5 * static_cast<double>(s[0]) + qk * static_cast<double>(v[0]),
               static_cast<double>(c[0]));
        printf("(0.5*s)[0]=%0.9e  (qk*v)[0]=%0.9e  got[1]=%0.9e  s-only? %s\n",
               0.5 * static_cast<double>(s[1]), qk * static_cast<double>(v[1]),
               static_cast<double>(c[1]),
               std::fabs(c[1] - 0.5 * static_cast<double>(s[1])) < 1e-6 ? "yes" : "no");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2); aclrtFree(p3); aclrtFree(p4);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return 0;
    }
    if (ORACLE == 5) {
        // sum(a) broadcast over the row: isolates reduce_sum + row_expand.
        double sum = 0.0;
        for (int i = 0; i < n; ++i) sum += static_cast<double>(a[i]);
        for (int i = 0; i < n; ++i) {
            const double d = std::fabs(static_cast<double>(c[i]) - sum);
            if (d > max_abs) max_abs = d;
            const double ref = std::fabs(sum) > 1e-12 ? std::fabs(sum) : 1.0;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, wrong, max_abs, max_rel);
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (const char *ref_file = std::getenv("DS4_REF_FILE")) {
        // Expected output from the HOST reference (f64 dequantisation of the same bytes), so
        // this compares an independent implementation against the device kernel -- the check
        // that matters when the inputs are REAL model tensors rather than synthetic ones.
        std::vector<float> want(n, 0.0f);
        FILE *fp = std::fopen(ref_file, "rb");
        if (!fp) {
            std::fprintf(stderr, "DS4_REF_FILE=%s: cannot open\n", ref_file);
            return 2;
        }
        const size_t got = std::fread(want.data(), sizeof(float), want.size(), fp);
        std::fclose(fp);
        if (got != want.size()) {
            std::fprintf(stderr, "DS4_REF_FILE: %zu floats, expected %zu\n", got, want.size());
            return 2;
        }
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        // Only the MV_N outputs the kernel actually writes. `n` has to cover the RAW BYTE
        // size of the weights, so it is far larger than the output and the tail of `c` is
        // whatever the allocation held.
        const size_t cmp = std::min(want.size(), static_cast<size_t>(MV_N));
        for (size_t i = 0; i < cmp; ++i) {
            const double d = std::fabs(static_cast<double>(c[i]) - static_cast<double>(want[i]));
            abs_sum += d;
            sum_ref += std::fabs(static_cast<double>(want[i]));
            if (d > max_abs) max_abs = d;
            // AGGREGATE, not per-element relative. The first version of this branch counted
            // an element "wrong" whenever d > tol*|want|, and 89 of 1024 tripped it on a
            // backward error of 1.4e-07: those are the outputs where the dot CANCELS and
            // |want| is ~0, which is precisely the metric this campaign retired for oracle 15.
            (void)d;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%zu wrong=%d max_abs=%.3e backward_rel=%.3e\n", cmp, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }
    if (ORACLE == 33) {
        // ATTENTION ACCUMULATION, unnormalised: out[c] = sum_r exp(score[r]) * kv[r][c].
        // `scores -> exp` is already certified (ORACLE 29) and the final scale is a single multiply,
        // so this isolates `row_axpy` accumulating 8 rows of V weighted by those exp values.
        const int S = MV_N, D = MV_K;
        static double w[256];
        for (int p = 0; p < S; ++p) {
            double s = static_cast<double>(v[p]);
            for (int d = 0; d < D; ++d)
                s += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            w[p] = std::exp(s);
        }
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int col = 0; col < D; ++col) {
            double want = 0.0;
            for (int p = 0; p < S; ++p) want += w[p] * static_cast<double>(b[p * D + col]);
            const double got = static_cast<double>(c[col]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", D, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 32) {
        // reduce -> scalar broadcast, nothing else: out[i] = sum_{j<8} a[j] for every i.
        // Separates the reduce's output from the scalar read that broadcasts it -- the two things
        // that `inf` could be coming from.
        double want = 0.0;
        for (int j = 0; j < 8; ++j) want += static_cast<double>(a[j]);
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int i = 0; i < MV_K; ++i) {
            const double got = static_cast<double>(c[i]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", MV_K, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 31) {
        // ATTENTION STAGE 2e: the broadcast denominator. out[i] = sum_p exp(score[p]) for every i,
        // i.e. the scalar broadcast that the softmax division consumes. Splits `col_expand(1 -> 8)`
        // from the `div` that follows it.
        const int S = MV_N, D = MV_K;
        double den = 0.0;
        for (int p = 0; p < S; ++p) {
            double s = static_cast<double>(v[p]);
            for (int d = 0; d < D; ++d)
                s += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            den += std::exp(s);
        }
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int i = 0; i < MV_K; ++i) {
            const double want = den;
            const double got = static_cast<double>(c[i]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", MV_K, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 30) {
        // ELEMENTWISE exp on a fresh load: out[i] = exp(a[i]). The final discrimination on the
        // attention softmax -- `exp` over 8 elements returned NaN from a buffer that the previous
        // stage had certified, so this asks whether the OP or its SOURCE is at fault.
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int i = 0; i < MV_K; ++i) {
            const double want = std::exp(static_cast<double>(a[i]));
            const double got = static_cast<double>(c[i]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", MV_K, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 29) {
        // ATTENTION STAGE 2d: exp(score) alone, 8 values. Isolates `exp` from `reduce_sum(1 x 8)`.
        const int S = MV_N, D = MV_K;
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int p = 0; p < S; ++p) {
            double s = static_cast<double>(v[p]);
            for (int d = 0; d < D; ++d)
                s += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            const double want = std::exp(s);
            const double got = static_cast<double>(c[p]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", S, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 28) {
        // ATTENTION STAGE 2c: sum of exp(score), no divide. One value out. Separates the
        // denominator (reduce_sum) and exp from the final division.
        const int S = MV_N, D = MV_K;
        double den = 0.0;
        for (int p = 0; p < S; ++p) {
            double s = static_cast<double>(v[p]);
            for (int d = 0; d < D; ++d)
                s += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            den += std::exp(s);
        }
        const double got = static_cast<double>(c[0]);
        const double diff = std::fabs(got - den);
        const double backward = diff / (std::fabs(den) > 1e-30 ? std::fabs(den) : 1.0);
        int bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=1 wrong=%d max_abs=%.3e backward_rel=%.3e\n", bad, diff, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 27) {
        // ATTENTION STAGE 2b: softmax WITHOUT the max shift. Identical to ORACLE 26 for bounded
        // inputs, and it exists to separate `reduce_max` from `exp`/`reduce_sum`/`div`: if the
        // kernel without a max-based `sub` passes, the 8-element reduce_max is the fault.
        const int S = MV_N, D = MV_K;
        static double sc[256];
        double den = 0.0;
        for (int p = 0; p < S; ++p) {
            double s = static_cast<double>(v[p]);
            for (int d = 0; d < D; ++d)
                s += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            sc[p] = std::exp(s);
            den += sc[p];
        }
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int p = 0; p < S; ++p) {
            const double want = sc[p] / den;
            const double got = static_cast<double>(c[p]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", S, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 26) {
        // ATTENTION STAGE 2: the softmax weights alone. out[p] = exp(score[p]-max)/sum_p exp(...),
        // with score[p] = sum_d kv[p][d]*q[d] + sink[p].
        const int S = MV_N, D = MV_K;
        static double sc[256];
        double m = -1e300;
        for (int p = 0; p < S; ++p) {
            double s = static_cast<double>(v[p]);
            for (int d = 0; d < D; ++d)
                s += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            sc[p] = s;
            if (s > m) m = s;
        }
        double den = 0.0;
        for (int p = 0; p < S; ++p) { sc[p] = std::exp(sc[p] - m); den += sc[p]; }
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int p = 0; p < S; ++p) {
            const double want = sc[p] / den;
            const double got = static_cast<double>(c[p]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", S, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 25) {
        // ATTENTION STAGE 1b: the dot products WITHOUT the sink. out[p] = sum_d kv[p][d]*q[d].
        // Separates `mul`+`reduce_sum` from the sink load and add, which is the only way to say
        // which of them produces inf.
        const int S = MV_N, D = MV_K;
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int p = 0; p < S; ++p) {
            double want = 0.0;
            for (int d = 0; d < D; ++d)
                want += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            const double got = static_cast<double>(c[p]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", S, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
