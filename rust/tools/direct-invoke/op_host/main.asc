        //   out[r] = sum_g ( se[g] * d[r*nb+g] + so[g] * d[r*nb+npair+g] )
        //   se[g] = sum_i tab[w[(r*npair+g)*32+i] & 15]  * x[g*32+i]
        //   so[g] = sum_i tab[w[(r*npair+g)*32+i] >> 4]  * x[(npair+g)*32+i]
        // The scale is HALVED (the kernel decodes 2*MXFP4[c]); tab is the
        // doubled codebook.
        const int ne00 = 5120, ne0 = 2304;
        const int nb = ne00 / 32, npair = nb / 2;
        static const double tab[16] = {0.0, 1.0, 2.0, 3.0, 4.0, 6.0, 8.0, 12.0,
                                       -0.0, -1.0, -2.0, -3.0, -4.0, -6.0, -8.0, -12.0};
