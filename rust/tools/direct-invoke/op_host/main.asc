        // IT EXISTS BECAUSE ORACLE 42 WAS WRONG ABOUT THIS KERNEL, not because the
        // kernel needed a looser one. Oracle 42 selected on the raw input and
        // reported `wrong=2, first disagreement at rank 0` for
        // router_sigmoid_topk_k3_1x896_k16: its forced 900.0 and 500.0 both become
        // exactly 1.0 under a sigmoid, so the two positions tie and the kernel's
        // lowest-index-first policy put them in the other order. The kernel was
        // right. Composing an activation with a selection changes which positions
        // tie, and an oracle that skips the activation cannot see that.
        const int k = MV_N;
        if (k <= 0 || k > n || k > 256 || n > (1 << 21)) {
            printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", k, k, 0.0, 0.0);
            printf("ORACLE 43 refuses: k = MV_N = %d against n = %d. Pass k as MV_N.\n", k, n);
            printf("FAIL\n");
            aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
            aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
            CHECK(aclrtResetDevice(0)); aclFinalize();
            return 2;
        }
        const int32_t *idx_out = reinterpret_cast<const int32_t *>(c.data());
        static double act[1 << 21];
        for (int i = 0; i < n; ++i) {
            act[i] = 1.0 / (1.0 + std::exp(-static_cast<double>(a[i])));
        }
        static bool taken43[1 << 21];
        for (int i = 0; i < n; ++i) taken43[i] = false;
        static int want43[256];
        int bad = 0, first_bad = -1;
        for (int j = 0; j < k; ++j) {
            double best = -1e300;
            int at = -1;
            for (int i = 0; i < n; ++i) {
                if (taken43[i]) continue;
                if (act[i] > best) { best = act[i]; at = i; }
            }
            want43[j] = at;
            taken43[at] = true;
            if (static_cast<int>(idx_out[j]) != at) {
                ++bad;
                if (first_bad < 0) first_bad = j;
            }
        }
        int lo = n, hi = 0, ties_at_top = 0;
        for (int j = 0; j < k; ++j) {
            if (want43[j] < lo) lo = want43[j];
            if (want43[j] > hi) hi = want43[j];
        }
        for (int i = 0; i < n; ++i) if (act[i] == act[want43[0]]) ++ties_at_top;
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", k, bad, 0.0, 0.0);
        // `ties_at_top` is the control that this input did NOT saturate: it must be 1,
        // or the activation has flattened the ranks that are supposed to discriminate
        // and the run proves less than it looks like it does.
        printf("sigmoid-topk k=%d n=%d spread=%d ties_at_top=%d want[0..3]=%d,%d,%d,%d "
               "got[0..3]=%d,%d,%d,%d\n",
               k, n, hi - lo, ties_at_top,
               want43[0], k > 1 ? want43[1] : -1, k > 2 ? want43[2] : -1,
               k > 3 ? want43[3] : -1,
               static_cast<int>(idx_out[0]),
               k > 1 ? static_cast<int>(idx_out[1]) : -1,
               k > 2 ? static_cast<int>(idx_out[2]) : -1,
               k > 3 ? static_cast<int>(idx_out[3]) : -1);
        if (bad) printf("first disagreement at rank %d\n", first_bad);
        printf("NOT COVERED: the k values through gm1 -- arity 3 copies back gm2 alone\n");
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
