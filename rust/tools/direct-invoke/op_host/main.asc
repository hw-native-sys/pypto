    }

    if (ORACLE == 24) {
        // ATTENTION STAGE 1: the scores only. out[p] = sum_d kv[p][d]*q[d] + sink[p], p < S.
        // This exists to bisect the attention kernel: when the whole thing faults, this says
        // whether the scores half is sound before the softmax and the weighted sum are added.
        const int S = MV_N, D = MV_K;
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int p = 0; p < S; ++p) {
            double want = static_cast<double>(v[p]);
            for (int d = 0; d < D; ++d)
                want += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            const double got = static_cast<double>(c[p]);
            const double d = std::fabs(got - want);
            abs_sum += d;
            sum_ref += std::fabs(want);
            if (d > max_abs) max_abs = d;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", S, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 34) {
        // ALL HEADS of the engine's attention socket: MV_N heads x MV_K = D, checking every output.
        // ORACLE 23 checks head 0 only, which cannot certify an extent of 64 x 512 -- a loop that
        // computed one head and zeroed the rest would pass it.
        const int H = MV_N, D = MV_K, S = 8;
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0, heads_seen = 0;
        static double sc[64], ew[64];
        for (int h = 0; h < H; ++h) {
            // scores over the 8 positions for THIS head: kv is shared (MQA), q and sink are per head.
            double m = -1e300;
            for (int p = 0; p < S; ++p) {
                double s = static_cast<double>(v[h * S + p]);
                for (int d = 0; d < D; ++d)
                    s += static_cast<double>(b[p * D + d]) * static_cast<double>(a[h * D + d]);
                sc[p] = s;
                if (s > m) m = s;
            }
            double den = 0.0;
            for (int p = 0; p < S; ++p) { ew[p] = std::exp(sc[p] - m); den += ew[p]; }
            for (int col = 0; col < D; ++col) {
                double want = 0.0;
                for (int p = 0; p < S; ++p) want += ew[p] * static_cast<double>(b[p * D + col]);
                want /= den;
                const double got = static_cast<double>(c[h * D + col]);
                const double diff = std::fabs(got - want);
                abs_sum += diff;
                sum_ref += std::fabs(want);
                if (diff > max_abs) max_abs = diff;
                if (!(diff <= 1e-3 * (std::fabs(want) + 1e-6))) bad = 1;
            }
            heads_seen++;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("heads=%d elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n",
               heads_seen, H * D, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 23) {
        // ONE-HEAD SINK ATTENTION. a = q[512], b = kv[128][512], v = sink[8], out[512].
        //   score[p] = sum_d kv[p][d]*q[d] + sink[p % 8]      (sink added to every block)
        //   out[c]   = sum_p softmax(score)[p] * kv[p][c]     (K and V are the same tensor, as the
        //                                                      fixture's single %kv implies)
        const int S = MV_N, D = MV_K;  // MV_N positions (8 or 128), MV_K head width.
        static double sc[256], ew[256];
        double m = -1e300;
        for (int p = 0; p < S; ++p) {
            double s = static_cast<double>(v[p % 8]);
            for (int d = 0; d < D; ++d)
                s += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            sc[p] = s;
            if (s > m) m = s;
        }
        double den = 0.0;
        for (int p = 0; p < S; ++p) { ew[p] = std::exp(sc[p] - m); den += ew[p]; }
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int col = 0; col < D; ++col) {
            double want = 0.0;
            for (int p = 0; p < S; ++p) want += ew[p] * static_cast<double>(b[p * D + col]);
            want /= den;
            const double got = static_cast<double>(c[col]);
            const double d = std::fabs(got - want);
            abs_sum += d;
            sum_ref += std::fabs(want);
            if (d > max_abs) max_abs = d;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", D, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 53) {
        // SCALED SINK ATTENTION -- the VIRTUAL-POSITION form, which is what the
        // engine's own CPU reference implements (attn_dispatch.rs:1428-1490:
        // `scores.push(attn_sinks[h])`, every QK score times 1/sqrt(head_dim), and
        // the weighted-sum loop starting at `scores[1]`, so the sink has no V).
        // This is a NEW id under the 2026-11-08 ruling: ORACLE 23 is the
        // ADDITIVE-BIAS probe (`score[p] = sum kv*q + sink[p%8]`, unscaled), which
        // matches the engine's stage probe but NOT the model's attention.
        //
        //   s_p    = (sum_d kv[p][d]*q[d]) / sqrt(D)
        //   m      = max(max_p s_p, max_j sink[j])
        //   den    = (1/SB) * sum_j exp(sink[j]-m) + sum_p exp(s_p-m)
        //   out[c] = sum_p exp(s_p-m)*kv[p][c] / den
        //
        // The (1/SB) is the lowering's own arithmetic, not a modelling choice: the
        // blocked form seeds the [1xSB] denominator with exp(sink_j-m)/SB per lane
        // and folds it with ONE trowsum, which adds the SB lanes once. Writing the
        // mean here makes the reference exact for ANY sink fill, including the
        // default ramp, so the sink term is exercised rather than discarded.
        const int S = MV_N, D = MV_K, SB = MV_N;  // the emitted kernel uses ONE block: SB == S
        static double sc[256], ew[256];
        const double inv = 1.0 / std::sqrt(static_cast<double>(D));
        double m = -1e300;
        for (int p = 0; p < S; ++p) {
            double s = 0.0;
            for (int d = 0; d < D; ++d)
                s += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            s *= inv;
            sc[p] = s;
            if (s > m) m = s;
        }
        for (int j = 0; j < SB; ++j)
            if (static_cast<double>(v[j]) > m) m = static_cast<double>(v[j]);
        double den = 0.0;
        for (int j = 0; j < SB; ++j)
            den += std::exp(static_cast<double>(v[j]) - m) / static_cast<double>(SB);
        for (int p = 0; p < S; ++p) { ew[p] = std::exp(sc[p] - m); den += ew[p]; }
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int col = 0; col < D; ++col) {
            double want = 0.0;
            for (int p = 0; p < S; ++p) want += ew[p] * static_cast<double>(b[p * D + col]);
            want /= den;
            const double got = static_cast<double>(c[col]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", D, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 56) {
        // SCALED, SINK-FREE 1-QUERY ATTENTION over S positions of K and V, the
        // arm `__tile_attention_blocked_f32` implements. GLM 5.3's sourced
        // index_topk = 2048 is the shape; no sink key exists in its config.
        //   s_p = (sum_d k[p][d]*q[d]) / sqrt(D)
        //   out[c] = sum_p exp(s_p - m) * v[p][c] / sum_p exp(s_p - m)
        const int S = MV_N, D = MV_K;
        static double sc56[4096], ew56[4096];
        const double inv = 1.0 / std::sqrt(static_cast<double>(D));
        if (S > 4096) {
            printf("ORACLE 56 refuses: S=%d exceeds the reference's 4096 slots\n", S);
            printf("FAIL\n");
            aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
            aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
            CHECK(aclrtResetDevice(0)); aclFinalize();
            return 2;
        }
        double m = -1e300;
        for (int p = 0; p < S; ++p) {
            double s = 0.0;
            for (int d = 0; d < D; ++d)
                s += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            s *= inv;
            sc56[p] = s;
            if (s > m) m = s;
        }
        double den = 0.0;
        for (int p = 0; p < S; ++p) { ew56[p] = std::exp(sc56[p] - m); den += ew56[p]; }
        // Effective support = 1 / sum(p^2). One-hot gives 1, a flat softmax gives
        // S. A 1%-of-denominator count is WRONG here: 2048 near-equal terms each
        // carry 1/2048 < 1%, so that test reported zero for a fully spread
        // softmax. This measure is scale-free and is what the guard needs.
        double sumsq = 0.0;
        for (int p = 0; p < S; ++p) {
            const double q = ew56[p] / den;
            sumsq += q * q;
        }
        const double eff = sumsq > 0.0 ? 1.0 / sumsq : 0.0;
        if (eff < 2.0) {
            printf("ORACLE 56 refuses: effective support %.3f of %d (one-hot would be 1), "
                   "so the weighted-V sum is untested.\n", eff, S);
            printf("FAIL\n");
            aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
            aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
            CHECK(aclrtResetDevice(0)); aclFinalize();
            return 2;
        }
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int col = 0; col < D; ++col) {
            double want = 0.0;
            for (int p = 0; p < S; ++p)
                want += ew56[p] * static_cast<double>(v[p * D + col]);
            want /= den;
            const double got = static_cast<double>(c[col]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e support=%.1f/%d\n",
               D, bad, max_abs, backward, eff, S);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 57) {
        // RUNTIME-S, SINK-FREE 1-QUERY ATTENTION. S comes from s[0] (what the
        // kernel reads from its 1x1 tile); D is MV_K. The same reference scores
        // any S the harness passes.
        const int S = static_cast<int>(s[0]);
        const int D = MV_K;
        if (S <= 0 || static_cast<long long>(S) * D > static_cast<long long>(n)) {
            printf("ORACLE 57 refuses: S=%d D=%d needs %lld elements, n=%d\n",
                   S, D, static_cast<long long>(S) * D, n);
            printf("FAIL\n");
            aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
            aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
            CHECK(aclrtResetDevice(0)); aclFinalize();
            return 2;
        }
        static double sc57[32768], ew57[32768];
        if (S > 32768) {
            printf("ORACLE 57 refuses: S=%d exceeds the reference's slots\n", S);
            printf("FAIL\n");
            aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
            aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
            CHECK(aclrtResetDevice(0)); aclFinalize();
            return 2;
        }
        const double inv = 1.0 / std::sqrt(static_cast<double>(D));
        double m = -1e300;
        for (int p = 0; p < S; ++p) {
            double acc = 0.0;
            for (int d = 0; d < D; ++d)
                acc += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            acc *= inv;
            sc57[p] = acc;
            if (acc > m) m = acc;
        }
        double den = 0.0;
        for (int p = 0; p < S; ++p) { ew57[p] = std::exp(sc57[p] - m); den += ew57[p]; }
        double sumsq = 0.0;
        for (int p = 0; p < S; ++p) { const double q = ew57[p] / den; sumsq += q * q; }
        const double eff = sumsq > 0.0 ? 1.0 / sumsq : 0.0;
        if (eff < 2.0) {
            printf("ORACLE 57 refuses: effective support %.3f of %d\n", eff, S);
            printf("FAIL\n");
            aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
            aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
            CHECK(aclrtResetDevice(0)); aclFinalize();
            return 2;
        }
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int col = 0; col < D; ++col) {
            double want = 0.0;
            for (int p = 0; p < S; ++p)
                want += ew57[p] * static_cast<double>(v[p * D + col]);
            want /= den;
            const double got = static_cast<double>(c[col]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e S=%d support=%.1f\n",
               D, bad, max_abs, backward, S, eff);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 58) {
        // MULTI-ROW ARGMAX: MV_N rows of MV_K, one i32 index per row, first
        // index attaining the row maximum (lowest-index tie policy).
        const int R = MV_N, C = MV_K;
        if (R <= 0 || C <= 0 || static_cast<long long>(R) * C > static_cast<long long>(n)) {
            printf("ORACLE 58 refuses: R=%d C=%d needs %lld elements, n=%d\n",
                   R, C, static_cast<long long>(R) * C, n);
            printf("FAIL\n");
