                for (int i = 0; i < 32; ++i) {
                    const uint8_t byte = w[(static_cast<size_t>(r) * npair + g) * 32 + i];
                    se += tab[byte & 0x0F] * static_cast<double>(x[g * 32 + i]);
                    so += tab[byte >> 4] * static_cast<double>(x[(npair + g) * 32 + i]);
