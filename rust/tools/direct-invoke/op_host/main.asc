            printf("FAIL\n");
            aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
            aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
            CHECK(aclrtResetDevice(0)); aclFinalize();
            return 2;
        }
        DI_T("copyback done, ref");
        const __fp16 *ah = reinterpret_cast<const __fp16 *>(a.data());
        const __fp16 *bh = reinterpret_cast<const __fp16 *>(b.data());
        const __fp16 *ch = reinterpret_cast<const __fp16 *>(c.data());
        double o48_max_abs = 0.0, o48_max_rel = 0.0, o48_ref_max = 0.0;
        double o48_ref_min = 1e300;
        int o48_wrong = 0;
        long long o48_first_bad = -1;
        // LOOP ORDER IS LOAD-BEARING AT LMHEAD SCALE, measured 2026-11-09. The first
        // form was `for m: for nn: for k: acc += ah[m*K+k] * bh[k*N+nn]`, which walks
        // B down a COLUMN: a stride of N halves, so at N = 12928 every one of the
        // M*N*K inner steps touches a fresh cache line AND a fresh page, and the whole
        // K*N array is re-walked once per output. At M=16 K=5120 N=12928 that is
        // 1.06e9 strided accesses over 132 MB and the run was still in the reference
        // after 23 MINUTES of 100% host CPU with AICore at 0% -- the device work had
        // long finished. It scored fine at the calibration shape (M=4 K=8 N=4, where
        // the whole array is 64 bytes), which is exactly why the cost was invisible.
        //
        // This form hoists k outside nn and accumulates a ROW of doubles, so B is read
        // sequentially. THE ARITHMETIC IS UNCHANGED: each output still sums over k in
        // ascending order, one f64 add at a time, so every value is bit-identical to
        // the strided form -- this is a memory-order change, not a numerical one. A
        // reference that cannot be computed is not a more conservative reference.
        std::vector<double> o48_acc(static_cast<size_t>(N));
        for (long long m = 0; m < M; ++m) {
            o48_acc.assign(static_cast<size_t>(N), 0.0);
            for (long long k = 0; k < K; ++k) {
                const double aik = static_cast<double>(ah[m * K + k]);
                const __fp16 *brow = bh + k * N;
                for (long long nn = 0; nn < N; ++nn) {
                    o48_acc[static_cast<size_t>(nn)] += aik * static_cast<double>(brow[nn]);
                }
            }
            for (long long nn = 0; nn < N; ++nn) {
                const double acc = o48_acc[static_cast<size_t>(nn)];
                const double got = static_cast<double>(ch[m * N + nn]);
                const double d = std::fabs(got - acc);
                const double ref = std::fabs(acc) > 1e-12 ? std::fabs(acc) : 1.0;
                const double aacc = std::fabs(acc);
                if (aacc > o48_ref_max) o48_ref_max = aacc;
                if (aacc < o48_ref_min) o48_ref_min = aacc;
                if (d > o48_max_abs) o48_max_abs = d;
                if (d / ref > o48_max_rel) o48_max_rel = d / ref;
                if (d / ref > TOLERANCE) {
                    ++o48_wrong;
                    if (o48_first_bad < 0) o48_first_bad = m * N + nn;
                }
            }
        }
        printf("elements=%lld wrong=%d max_abs=%.3e max_rel=%.3e\n",
               mn, o48_wrong, o48_max_abs, o48_max_rel);
        // THE REFERENCE SPREAD IS A CONTROL, not decoration. If every |C| were tiny
        // or all equal, a blocked arm that dropped a K-block or transposed B could
        // still agree and the run would report a PASS refuting nothing.
        printf("dtype=f16 M=%lld K=%lld N=%lld n=%d need_bytes=%lld ref_abs %.6e .. "
               "%.6e first_bad=%lld\n", M, K, N, n, need_bytes, o48_ref_min,
               o48_ref_max, o48_first_bad);
        printf("%s\n", o48_wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return o48_wrong == 0 ? 0 : 2;
    }
#endif

    if (ORACLE == 47) {
        // SUB-BLOCK STORE: did it write PAST the extent it was given?
        // MV_N is the byte count handed to the store. `a` holds the 1..127 ramp the
        // kernel loaded; `c` is the output buffer, pre-filled with 0xA5.
        //
        //   bytes [0, MV_N)         must equal the source  -> the store delivered
        //   bytes [MV_N, GUARD_END) must still be 0xA5     -> it wrote nothing more
        //
        // CANDIDATES:
        //   writes exactly MV_N        -> delivered, guard_breach = 0
        //   writes a whole 32-B block  -> breach starts AT MV_N and ends at the
        //                                 block boundary
        //   replicates element 0       -> the breached bytes equal source byte 0,
        //                                 which `breach_equals_src0` counts
        // ESCAPE ARM: any other shape means the space is mis-drawn. The first breach
        // offset and its value are printed for exactly that case; do not interpret
        // past them.
        const int GUARD_END = 128;
        if (MV_N <= 0 || MV_N > GUARD_END
            || static_cast<size_t>(GUARD_END) > static_cast<size_t>(n) * sizeof(float)) {
            printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, n, 0.0, 0.0);
            printf("ORACLE 47 refuses: MV_N = %d must be in 1..%d and the output must "
                   "hold at least %d bytes.\n", MV_N, GUARD_END, GUARD_END);
            printf("FAIL\n");
            aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
            aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
            CHECK(aclrtResetDevice(0)); aclFinalize();
            return 2;
        }
        const int8_t *a47 = reinterpret_cast<const int8_t *>(a.data());
        const int8_t *c47 = reinterpret_cast<const int8_t *>(c.data());
        const int8_t SENT = static_cast<int8_t>(0xA5);
        int o47_wrote = 0, o47_breach = 0, o47_first = -1, o47_repl = 0, o47_first_val = 0;
        for (int k = 0; k < MV_N; ++k) {
            if (c47[k] == a47[k]) ++o47_wrote;
        }
        for (int k = MV_N; k < GUARD_END; ++k) {
            if (c47[k] != SENT) {
                ++o47_breach;
                if (o47_first < 0) { o47_first = k; o47_first_val = c47[k]; }
                if (c47[k] == a47[0]) ++o47_repl;
            }
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n",
               MV_N, (MV_N - o47_wrote) + o47_breach, 0.0, 0.0);
        printf("store_bytes=%d delivered=%d guard_breach=%d first_breach=%d "
               "first_breach_val=%d breach_equals_src0=%d guard_end=%d\n",
               MV_N, o47_wrote, o47_breach, o47_first, o47_first_val, o47_repl, GUARD_END);
        printf("%s\n", (o47_wrote == MV_N && o47_breach == 0) ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return (o47_wrote == MV_N && o47_breach == 0) ? 0 : 2;
    }

    if (ORACLE == 46) {
        // NARROW-DTYPE FLOOR: did the first MV_N int8 BYTES of the load arrive?
        // `a` holds the 1..127 pattern; `c` is read back from the kernel's output.
        // MV_N is the element count under test, in int8 elements = bytes.
        //
        // THE KERNEL MUST STORE A WHOLE NUMBER OF BLOCKS so that this measures the
        // LOAD floor and not the store's. The probe stores 64 bytes regardless of how
        // many it loaded, and poisons its buffer first, so a byte that did not arrive
        // reads as the poison rather than as whatever the buffer held.
        //
        // READ IT AGAINST THE TWO RULES:
        //   a 32-BYTE floor  -> MV_N = 8, 16, 31 do NOT arrive; 32 and 64 do
        //   an 8-ELEMENT floor -> every MV_N >= 8 arrives
        // Those differ at 8, 16 and 31, so one sweep decides it.
        if (MV_N <= 0
            || static_cast<size_t>(MV_N) > static_cast<size_t>(n) * sizeof(float)) {
            printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, n, 0.0, 0.0);
            printf("ORACLE 46 refuses: MV_N = %d int8 byte(s) but the input holds only "
                   "%zu. Pass the byte count under test as MV_N.\n",
                   MV_N, static_cast<size_t>(n) * sizeof(float));
            printf("FAIL\n");
            aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
            aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
            CHECK(aclrtResetDevice(0)); aclFinalize();
            return 2;
        }
        const int8_t *a_bytes = reinterpret_cast<const int8_t *>(a.data());
        const int8_t *c_bytes = reinterpret_cast<const int8_t *>(c.data());
        int o46_arrived = 0, o46_first_bad = -1, o46_zeros = 0, o46_poison = 0;
        for (int k = 0; k < MV_N; ++k) {
            if (a_bytes[k] == 0) ++o46_zeros;
            if (c_bytes[k] == a_bytes[k]) {
                ++o46_arrived;
            } else {
                if (o46_first_bad < 0) o46_first_bad = k;
                if (c_bytes[k] == static_cast<int8_t>(-1)) ++o46_poison;
            }
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n",
               MV_N, MV_N - o46_arrived, 0.0, 0.0);
        // zeros_in_input is a CONTROL and must read 0: a zero byte could not be told
        // from a cleared hold. poison_bytes says the cells that did not arrive still
        // hold what the kernel put there, which is what distinguishes "not written"
        // from "written wrongly".
        printf("i8_bytes=%d arrived=%d first_mismatch=%d poison_bytes=%d "
               "zeros_in_input=%d\n",
               MV_N, o46_arrived, o46_first_bad, o46_poison, o46_zeros);
        printf("%s\n", o46_arrived == MV_N ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return o46_arrived == MV_N ? 0 : 2;
    }

    if (ORACLE == 45) {
        // EXACT IDENTITY: out[i] must equal in[i] for every element of MV_N x MV_K,
        // with NO tolerance at all. `a` is the input, `c` the output. Added under the
        // owner's 2026-11-08 ruling (NEW IDS ONLY); nothing existing is touched.
        //
        // WHY IT HAD TO EXIST. The corpus's rope_v41_8x64 declares its position as the
        // literal constant 0, and rope rotates each pair by theta = pos * freq, so at
        // pos 0 every theta is 0, cos = 1, sin = 0, and the rotation matrix is I. The
        // element-exact copy the emitter produces is therefore the COMPLETE and CORRECT
        // specification of that kernel, and no rope-shaped oracle can be invoked against
        // it: ORACLE 12 (rope over halves) takes FOUR GM buffers for cos and sin, and
        // this artefact has two. So the thing to check is identity, exactly.
        //
        // WHAT THIS DOES NOT ESTABLISH, stated here so the row cannot be read wider than
        // it is: a PASS says the artefact computes rope AT POSITION 0. It says NOTHING
        // about rope at any other position, because at pos 0 a faithful rotation and a
        // plain copy are bit-identical and no device run against this corpus can tell
        // them apart. The claim is EXISTENTIAL -- this shape, this position -- and the
        // refuting class for the general arm lives in the emitter's unit tests, where a
        // nonzero pos must still carry the substitution marker.
        //
        // ZERO TOLERANCE IS THE POINT. A copy that is merely close is not a copy, and a
        // tolerance here would be a dial to turn when the answer came out wrong.
        if (MV_N <= 0 || MV_K <= 0 || MV_N * MV_K != n) {
            printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, n, 0.0, 0.0);
            printf("ORACLE 45 refuses: MV_N*MV_K = %d but n = %d. Pass the row count and "
                   "row width so every element the kernel writes is compared.\n",
                   MV_N * MV_K, n);
            printf("FAIL\n");
            aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
            aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
            CHECK(aclrtResetDevice(0)); aclFinalize();
            return 2;
        }
        int o45_wrong = 0, o45_zeros = 0;
        double o45_max_abs = 0.0, o45_min_abs_in = 1e300;
        for (int i = 0; i < MV_N * MV_K; ++i) {
            const double want = static_cast<double>(a[i]);
            const double got = static_cast<double>(c[i]);
            const double d = std::fabs(got - want);
            if (d > o45_max_abs) o45_max_abs = d;
            if (d != 0.0) ++o45_wrong;
            if (a[i] == 0.0f) ++o45_zeros;
            if (std::fabs(want) < o45_min_abs_in) o45_min_abs_in = std::fabs(want);
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n",
               MV_N * MV_K, o45_wrong, o45_max_abs, 0.0);
        // THE ZERO COUNT IS A CONTROL, NOT DECORATION. An input element that is exactly
        // 0.0 cannot distinguish "the copy wrote it" from "nothing wrote it and the hold
        // read back cleared" -- the collision that voided a device reading on 2026-11-09.
        // If this count is ever nonzero the PASS is that much weaker, and the reader must
        // see it from the run rather than reason about the ramp.
        printf("rows=%d cols=%d zeros_in_input=%d min_abs_input=%.6e tolerance=EXACT\n",
               MV_N, MV_K, o45_zeros, o45_min_abs_in);
        printf("%s\n", o45_wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
