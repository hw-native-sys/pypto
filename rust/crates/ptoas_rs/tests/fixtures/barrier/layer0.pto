    %pto15 = "pto.get_block_idx"() : () -> i64
    %pto16 = "pto.get_block_num"() : () -> i64
    %pto17 = arith.index_cast %pto15 : i64 to index
    %pto18 = arith.index_cast %pto16 : i64 to index
    scf.for %r = %pto17 to %c1024 step %pto18 {  // [AIV grid] over ne0 output rows
