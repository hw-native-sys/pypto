      %pto19 = pto.partition_view %pto3, offsets = [%r, %c0], sizes = [%c1, %c4096] : !pto.tensor_view<?x?xsi8> -> !pto.partition_tensor_view<1x4096xsi8>
      pto.tload ins(%pto19 : !pto.partition_tensor_view<1x4096xsi8>) outs(%pto6 : !pto.tile_buf<loc=vec, dtype=si8, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // int8 weights row r
      pto.tcvt ins(%pto6 : !pto.tile_buf<loc=vec, dtype=si8, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto7 : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // si8 -> f16
      pto.tcvt ins(%pto7 : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto8 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // f16 -> f32
      pto.tmul ins(%pto8, %pto2 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto9 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      pto.barrier <PIPE_ALL>
      %pto20 = pto.partition_view %pto4, offsets = [%r, %c0], sizes = [%c1, %c4096] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x4096xf32>
      pto.tload ins(%pto20 : !pto.partition_tensor_view<1x4096xf32>) outs(%pto10 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // per-element scale sd[r][i]=d[r][i/32]
      pto.tmul ins(%pto9, %pto10 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto11 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // apply block scale (per-element)
      pto.barrier <PIPE_ALL>
      pto.tmov ins(%pto11 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto14 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // seed the fold
      pto.barrier <PIPE_ALL>
      pto.trowsum ins(%pto14, %pto12 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto13 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=1, v_row=1, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>)
      pto.barrier <PIPE_ALL>
      %pto21 = pto.partition_view %pto5, offsets = [%c0, %r], sizes = [%c1, %c1] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x1xf32>
      pto.tstore ins(%pto13 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=1, v_row=1, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>) outs(%pto21 : !pto.partition_tensor_view<1x1xf32>)
    }
    // multi-row: ne0=512 rows across AIV grid; nb=128 blocks/row. REAL int8 matvec/row: tload(si8)->tcvt si8->f16->f32->tmul(x)->tmul(scale)->trowsum->tstore.
    return
  }

  func.func @ds4_q8mv_8192_4096(%w: !pto.ptr<si8>, %s: !pto.ptr<f32>, %x: !pto.ptr<f32>, %o: !pto.ptr<f32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4096 = arith.constant 4096 : index
    %c8192 = arith.constant 8192 : index
    // === DS4-Flash Q8_0 matvec (signal path): dst[4096] = W_expert . x[8192] ===
    // weights=%w input=%x ids=%s dst=%o  (nb=256 blocks/row, QK8_0=32)
    // block_q8_0 = 34 B: half d@0, int8 qs[32]@2
    %pto0 = pto.make_tensor_view %x, shape = [%c1, %c8192], strides = [%c8192, %c1] : !pto.tensor_view<?x?xf32>
    %pto1 = pto.partition_view %pto0, offsets = [%c0, %c0], sizes = [%c1, %c4096] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x4096xf32>
    %pto2 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tload ins(%pto1 : !pto.partition_tensor_view<1x4096xf32>) outs(%pto2 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // activation row x, resident across rows (chunk 1/2)
    %pto3 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto4 = pto.partition_view %pto0, offsets = [%c0, %c4096], sizes = [%c1, %c4096] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x4096xf32>
    pto.tload ins(%pto4 : !pto.partition_tensor_view<1x4096xf32>) outs(%pto3 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // activation row x, resident across rows (chunk 2/2)
    %pto5 = pto.make_tensor_view %w, shape = [%c4096, %c8192], strides = [%c8192, %c1] : !pto.tensor_view<?x?xsi8>
    %pto6 = pto.make_tensor_view %s, shape = [%c4096, %c8192], strides = [%c8192, %c1] : !pto.tensor_view<?x?xf32>
    %pto7 = pto.make_tensor_view %o, shape = [%c1, %c4096], strides = [%c4096, %c1] : !pto.tensor_view<?x?xf32>
    %pto8 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=si8, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto9 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto10 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto11 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto12 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto13 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto14 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto15 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=1, v_row=1, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>
    %pto16 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>  // chunk fold
    %pto17 = "pto.get_block_idx"() : () -> i64
    %pto18 = "pto.get_block_num"() : () -> i64
    %pto19 = arith.index_cast %pto17 : i64 to index
    %pto20 = arith.index_cast %pto18 : i64 to index
    scf.for %r = %pto19 to %c4096 step %pto20 {  // [AIV grid] over ne0 output rows
      // reduction chunk 1/2 at +0
      %pto21 = pto.partition_view %pto5, offsets = [%r, %c0], sizes = [%c1, %c4096] : !pto.tensor_view<?x?xsi8> -> !pto.partition_tensor_view<1x4096xsi8>
      pto.tload ins(%pto21 : !pto.partition_tensor_view<1x4096xsi8>) outs(%pto8 : !pto.tile_buf<loc=vec, dtype=si8, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // int8 weights row r
      pto.tcvt ins(%pto8 : !pto.tile_buf<loc=vec, dtype=si8, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto9 : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // si8 -> f16
      pto.tcvt ins(%pto9 : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto10 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // f16 -> f32
      pto.tmul ins(%pto10, %pto2 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto11 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      pto.barrier <PIPE_ALL>
      %pto22 = pto.partition_view %pto6, offsets = [%r, %c0], sizes = [%c1, %c4096] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x4096xf32>
      pto.tload ins(%pto22 : !pto.partition_tensor_view<1x4096xf32>) outs(%pto12 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // per-element scale sd[r][i]=d[r][i/32]
      pto.tmul ins(%pto11, %pto12 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto13 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // apply block scale (per-element)
      pto.barrier <PIPE_ALL>
      pto.tmov ins(%pto13 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto16 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // seed the fold
      pto.barrier <PIPE_ALL>
      // reduction chunk 2/2 at +4096
      %pto23 = pto.partition_view %pto5, offsets = [%r, %c4096], sizes = [%c1, %c4096] : !pto.tensor_view<?x?xsi8> -> !pto.partition_tensor_view<1x4096xsi8>
      pto.tload ins(%pto23 : !pto.partition_tensor_view<1x4096xsi8>) outs(%pto8 : !pto.tile_buf<loc=vec, dtype=si8, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // int8 weights row r
      pto.tcvt ins(%pto8 : !pto.tile_buf<loc=vec, dtype=si8, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto9 : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // si8 -> f16
      pto.tcvt ins(%pto9 : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto10 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // f16 -> f32
      pto.tmul ins(%pto10, %pto3 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto11 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      pto.barrier <PIPE_ALL>
      %pto24 = pto.partition_view %pto6, offsets = [%r, %c4096], sizes = [%c1, %c4096] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x4096xf32>
      pto.tload ins(%pto24 : !pto.partition_tensor_view<1x4096xf32>) outs(%pto12 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // per-element scale sd[r][i]=d[r][i/32]
      pto.tmul ins(%pto11, %pto12 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto13 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // apply block scale (per-element)
      pto.barrier <PIPE_ALL>
      pto.tadd ins(%pto16, %pto13 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto16 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // fold chunk
      pto.barrier <PIPE_ALL>
      pto.trowsum ins(%pto16, %pto14 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto15 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=1, v_row=1, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>)
      pto.barrier <PIPE_ALL>
      %pto25 = pto.partition_view %pto7, offsets = [%c0, %r], sizes = [%c1, %c1] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x1xf32>
      pto.tstore ins(%pto15 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=1, v_row=1, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>) outs(%pto25 : !pto.partition_tensor_view<1x1xf32>)
    }
    // multi-row: ne0=4096 rows across AIV grid; nb=256 blocks/row. REAL int8 matvec/row: tload(si8)->tcvt si8->f16->f32->tmul(x)->tmul(scale)->trowsum->tstore.
    return
  }

  func.func @ds4_rmsmul_4096(%x: !pto.ptr<f32>, %g: !pto.ptr<f32>, %o: !pto.ptr<f32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4096 = arith.constant 4096 : index
    %pto0 = pto.make_tensor_view %x, shape = [%c1, %c4096], strides = [%c4096, %c1] : !pto.tensor_view<?x?xf32>
    %pto1 = pto.partition_view %pto0, offsets = [%c0, %c0], sizes = [%c1, %c4096] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x4096xf32>
    %pto2 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tload ins(%pto1 : !pto.partition_tensor_view<1x4096xf32>) outs(%pto2 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    %pto3 = pto.make_tensor_view %g, shape = [%c1, %c4096], strides = [%c4096, %c1] : !pto.tensor_view<?x?xf32>
    %pto4 = pto.partition_view %pto3, offsets = [%c0, %c0], sizes = [%c1, %c4096] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x4096xf32>
    %pto5 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tload ins(%pto4 : !pto.partition_tensor_view<1x4096xf32>) outs(%pto5 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    %pto6 = arith.constant 0.000244141 : f32
    %pto7 = arith.constant 0.000001 : f32
    %pto8 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto9 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=2048, v_row=1, v_col=2048, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto10 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=1, v_row=1, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>
    %pto11 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto12 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto13 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto14 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=1, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto15 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto16 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>
