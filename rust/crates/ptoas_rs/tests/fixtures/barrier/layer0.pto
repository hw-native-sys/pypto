    pto.tmul ins(%pto16, %pto5 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=512, v_row=1, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=512, v_row=1, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto17 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=512, v_row=1, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    %pto18 = pto.make_tensor_view %o, shape = [%c1, %c512], strides = [%c512, %c1] : !pto.tensor_view<?x?xf32>
    %pto19 = pto.partition_view %pto18, offsets = [%c0, %c0], sizes = [%c1, %c512] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x512xf32>
    pto.tstore ins(%pto17 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=512, v_row=1, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto19 : !pto.partition_tensor_view<1x512xf32>)
    return
  }

  func.func @ds4_rope_halves(%x: !pto.ptr<f32>, %cs: !pto.ptr<f32>, %sn: !pto.ptr<f32>, %o: !pto.ptr<f32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c32 = arith.constant 32 : index
    %c64 = arith.constant 64 : index
    // --- rope (halves): o[0..32) = x1*cos - x2*sin, o[32..64) = x2*cos + x1*sin ---
    %pto0 = pto.make_tensor_view %x, shape = [%c1, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xf32>
    %pto1 = pto.partition_view %pto0, offsets = [%c0, %c0], sizes = [%c1, %c32] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x32xf32>
    %pto2 = pto.partition_view %pto0, offsets = [%c0, %c32], sizes = [%c1, %c32] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x32xf32>
    %pto3 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto4 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tload ins(%pto1 : !pto.partition_tensor_view<1x32xf32>) outs(%pto3 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // x_lo
    pto.tload ins(%pto2 : !pto.partition_tensor_view<1x32xf32>) outs(%pto4 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // x_hi
    %pto5 = pto.make_tensor_view %cs, shape = [%c1, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xf32>
    %pto6 = pto.partition_view %pto5, offsets = [%c0, %c0], sizes = [%c1, %c32] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x32xf32>
    %pto7 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tload ins(%pto6 : !pto.partition_tensor_view<1x32xf32>) outs(%pto7 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // cos
    %pto8 = pto.make_tensor_view %sn, shape = [%c1, %c32], strides = [%c32, %c1] : !pto.tensor_view<?x?xf32>
    %pto9 = pto.partition_view %pto8, offsets = [%c0, %c0], sizes = [%c1, %c32] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x32xf32>
    %pto10 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tload ins(%pto9 : !pto.partition_tensor_view<1x32xf32>) outs(%pto10 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // sin
    pto.barrier <PIPE_ALL>
    %pto11 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto12 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto13 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tmul ins(%pto3, %pto7 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto11 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tmul ins(%pto4, %pto10 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto12 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tsub ins(%pto11, %pto12 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto13 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.barrier <PIPE_ALL>
    %pto14 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto15 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %pto16 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tmul ins(%pto4, %pto7 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto14 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tmul ins(%pto3, %pto10 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto15 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tadd ins(%pto14, %pto15 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto16 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.barrier <PIPE_ALL>
    %pto17 = pto.make_tensor_view %o, shape = [%c1, %c64], strides = [%c64, %c1] : !pto.tensor_view<?x?xf32>
    %pto18 = pto.partition_view %pto17, offsets = [%c0, %c0], sizes = [%c1, %c32] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x32xf32>
    %pto19 = pto.partition_view %pto17, offsets = [%c0, %c32], sizes = [%c1, %c32] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x32xf32>
    pto.tstore ins(%pto13 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto18 : !pto.partition_tensor_view<1x32xf32>)
    pto.tstore ins(%pto16 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto19 : !pto.partition_tensor_view<1x32xf32>)
    return
  }

  func.func @ds4_attn_sink_batched(%q: !pto.ptr<f32>, %kv: !pto.ptr<f32>, %sk: !pto.ptr<f32>, %o: !pto.ptr<f32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c8 = arith.constant 8 : index
    %c16 = arith.constant 16 : index
    %c24 = arith.constant 24 : index
    %c32 = arith.constant 32 : index
    %c40 = arith.constant 40 : index
    %c48 = arith.constant 48 : index
    %c56 = arith.constant 56 : index
    %c64 = arith.constant 64 : index
    %c72 = arith.constant 72 : index
    %c80 = arith.constant 80 : index
    %c88 = arith.constant 88 : index
    %c96 = arith.constant 96 : index
    %c104 = arith.constant 104 : index
    %c112 = arith.constant 112 : index
    %c120 = arith.constant 120 : index
    %c128 = arith.constant 128 : index
    %c512 = arith.constant 512 : index
    %c32768 = arith.constant 32768 : index
    // === batched sink attention: 64 heads, S=128, D=512, block 8 — one launch, heads across cores (was 64 launches) ===
    %pto0 = pto.make_tensor_view %o, shape = [%c32768, %c1], strides = [%c1, %c1] : !pto.tensor_view<?x?xf32>
    %pto1 = "pto.get_block_idx"() : () -> i64
    %pto2 = "pto.get_block_num"() : () -> i64
    %pto3 = arith.index_cast %pto1 : i64 to index
    %pto4 = arith.index_cast %pto2 : i64 to index
    scf.for %r = %pto3 to %c64 step %pto4 {
    %pto5 = arith.constant 0.044194173 : f32
    %pto6 = arith.constant 0.00000000 : f32
    %pto7 = arith.constant 1.00000000 : f32
    // --- flash-blocked decode attention: S=128 as 16 blocks of 8, D=512 ---
    %pto8 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=512, v_row=8, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>  // pool: broadcast Q
    %pto9 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=512, v_row=8, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>  // pool: K or V block
    %pto10 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=512, v_row=8, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>  // pool: elementwise product
    %pto11 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=512, cols=8, v_row=512, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>  // pool: transpose scratch / product
    %pto12 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=512, cols=8, v_row=512, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>  // pool: transposed
    %pto13 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=512, cols=8, v_row=512, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>  // pool: broadcast weights
    %pto14 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=512, cols=8, v_row=512, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>  // pool: weighted-V accumulator A
    %pto15 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=512, cols=8, v_row=512, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>  // pool: weighted-V accumulator B
    %pto16 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>  // pool: [1xSB] scratch
    %pto17 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>  // pool: [1xSB] scratch
    %pto18 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>  // pool: [1xSB] fold A
    %pto19 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>  // pool: [1xSB] fold B
    %pto20 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=1, v_row=1, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>  // global max
    %pto21 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=1, v_row=1, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>  // global softmax denominator
    %pto22 = pto.make_tensor_view %q, shape = [%c64, %c512], strides = [%c512, %c1] : !pto.tensor_view<?x?xf32>
      %pto23 = pto.partition_view %pto22, offsets = [%r, %c0], sizes = [%c1, %c512] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x512xf32>
    %pto24 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=512, v_row=1, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>  // Q[1xD]
    pto.tload ins(%pto23 : !pto.partition_tensor_view<1x512xf32>) outs(%pto24 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=512, v_row=1, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // Q[1xD] (1-query decode)
    pto.tcolexpand ins(%pto24 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=512, v_row=1, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto8 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=512, v_row=8, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // broadcast Q across SB rows
    pto.barrier <PIPE_ALL>
    %pto25 = pto.make_tensor_view %sk, shape = [%c64, %c8], strides = [%c8, %c1] : !pto.tensor_view<?x?xf32>
      %pto26 = pto.partition_view %pto25, offsets = [%r, %c0], sizes = [%c1, %c8] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x8xf32>
    %pto27 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>  // attn sink [1xSB]
    pto.tload ins(%pto26 : !pto.partition_tensor_view<1x8xf32>) outs(%pto27 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // per-head sink logit
    pto.barrier <PIPE_ALL>
    %pto28 = pto.make_tensor_view %kv, shape = [%c128, %c512], strides = [%c512, %c1] : !pto.tensor_view<?x?xf32>
    // block 1/16: scores (pass A)
    %pto29 = pto.partition_view %pto28, offsets = [%c0, %c0], sizes = [%c8, %c512] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<8x512xf32>
    pto.tload ins(%pto29 : !pto.partition_tensor_view<8x512xf32>) outs(%pto9 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=512, v_row=8, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tmul ins(%pto9, %pto8 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=512, v_row=8, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=512, v_row=8, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto10 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=512, v_row=8, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // K_b .* broadcast(Q)
    pto.barrier <PIPE_ALL>
    pto.ttrans ins(%pto10, %pto11 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=512, v_row=8, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=512, cols=8, v_row=512, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto12 : !pto.tile_buf<loc=vec, dtype=f32, rows=512, cols=8, v_row=512, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.barrier <PIPE_ALL>
    pto.tcolsum ins(%pto12 : !pto.tile_buf<loc=vec, dtype=f32, rows=512, cols=8, v_row=512, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto17 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // scores [1xSB]
    pto.tmuls ins(%pto17, %pto5 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>, f32) outs(%pto16 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // * 1/sqrt(D)
    pto.barrier <PIPE_ALL>
    pto.tmov ins(%pto16 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto18 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=8, v_row=1, v_col=8, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // seed the max fold
    pto.barrier <PIPE_ALL>
    // block 2/16: scores (pass A)
    %pto30 = pto.partition_view %pto28, offsets = [%c8, %c0], sizes = [%c8, %c512] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<8x512xf32>
    pto.tload ins(%pto30 : !pto.partition_tensor_view<8x512xf32>) outs(%pto9 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=512, v_row=8, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tmul ins(%pto9, %pto8 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=512, v_row=8, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=512, v_row=8, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto10 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=512, v_row=8, v_col=512, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // K_b .* broadcast(Q)
    pto.barrier <PIPE_ALL>
