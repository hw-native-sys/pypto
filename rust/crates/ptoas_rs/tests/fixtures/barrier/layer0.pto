      pto.tcvt ins(%pto7 : !pto.tile_buf<loc=vec, dtype=f16, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto8 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // f16 -> f32
      pto.tmul ins(%pto8, %pto2 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto9 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      pto.barrier <PIPE_ALL>
      %pto20 = pto.partition_view %pto4, offsets = [%r, %c0], sizes = [%c1, %c4096] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x4096xf32>
      pto.tload ins(%pto20 : !pto.partition_tensor_view<1x4096xf32>) outs(%pto10 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // per-element scale sd[r][i]=d[r][i/32]
      pto.tmul ins(%pto9, %pto10 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto11 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // apply block scale (per-element)
      pto.barrier <PIPE_ALL>
      pto.tmov ins(%pto11 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%pto14 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // seed the fold
