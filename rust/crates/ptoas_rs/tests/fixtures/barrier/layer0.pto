      pto.barrier <PIPE_ALL>
      %pto21 = pto.partition_view %pto5, offsets = [%c0, %r], sizes = [%c1, %c1] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x1xf32>
      pto.tstore ins(%pto13 : !pto.tile_buf<loc=vec, dtype=f32, rows=8, cols=1, v_row=1, v_col=1, blayout=col_major, slayout=none_box, fractal=512, pad=0>) outs(%pto21 : !pto.partition_tensor_view<1x1xf32>)
    }
