      %pto19 = pto.partition_view %pto3, offsets = [%r, %c0], sizes = [%c1, %c4096] : !pto.tensor_view<?x?xsi8> -> !pto.partition_tensor_view<1x4096xsi8>
      pto.tload ins(%pto19 : !pto.partition_tensor_view<1x4096xsi8>) outs(%pto6 : !pto.tile_buf<loc=vec, dtype=si8, rows=1, cols=4096, v_row=1, v_col=4096, blayout=row_major, slayout=none_box, fractal=512, pad=0>)  // int8 weights row r
