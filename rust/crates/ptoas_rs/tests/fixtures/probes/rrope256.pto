module {
  func.func @rrope256(%x: !pto.ptr<f32>, %cs: !pto.ptr<f32>, %sn: !pto.ptr<f32>, %o: !pto.ptr<f32>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c128 = arith.constant 128 : index
    %c256 = arith.constant 256 : index
    %xtv = pto.make_tensor_view %x, shape = [%c1, %c256], strides = [%c256, %c1] : !pto.tensor_view<?x?xf32>
    %x1pv = pto.partition_view %xtv, offsets = [%c0, %c0], sizes = [%c1, %c128] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x128xf32>
    %x2pv = pto.partition_view %xtv, offsets = [%c0, %c128], sizes = [%c1, %c128] : !pto.tensor_view<?x?xf32> -> !pto.partition_tensor_view<1x128xf32>
    %x1 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=128, v_row=1, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>
