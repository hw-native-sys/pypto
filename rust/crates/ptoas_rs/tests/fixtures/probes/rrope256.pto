    pto.tload ins(%x1pv : !pto.partition_tensor_view<1x128xf32>) outs(%x1 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=128, v_row=1, v_col=128, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
