#include <pto/pto-inst.hpp>

#include "platform_comm/comm_context.h"
#include "pto/comm/comm_types.hpp"
#include "pto/comm/pto_comm_inst.hpp"
#include "tensor.h"

namespace {

static constexpr int64_t kTileCount = 256;
static constexpr int kMaxSupportedRanks = 16;

template <typename T>
AICORE inline __gm__ T *CommRemotePtr(__gm__ CommContext *ctx, __gm__ T *local_ptr, int pe) {
  uint64_t local_base = ctx->windowsIn[ctx->rankId];
  uint64_t offset = reinterpret_cast<uint64_t>(local_ptr) - local_base;
  return reinterpret_cast<__gm__ T *>(ctx->windowsIn[pe] + offset);
}

// Makes preceding GM/window stores visible before a peer Wait/load.
AICORE inline void PublishFence() {
  pipe_barrier(PIPE_ALL);
  dsb(DSB_DDR);
}

// N-way barrier on one signal column (row stride `signal_stride`):
// AtomicAdd(+1) to each peer's cell → Wait(GE 1) on each peer's cell →
// AtomicAdd(-1) to clear. Used twice per call on column 0 (entry + exit).
// Reusing the same column is safe: a rank cannot start occurrence K+1 until
// its own K has wait+cleared, and cannot finish K until peers have entered K,
// so notifies cannot cross occurrences. (Ring allreduce needs a distinct
// column per round because it only syncs adjacent ranks.)
AICORE inline void ExchangeBarrier(__gm__ CommContext *comm_ctx, __gm__ int32_t *signal_base, int my_rank,
                                    int nranks, int64_t signal_stride) {
  for (int peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    __gm__ int32_t *remote_signal =
        CommRemotePtr(comm_ctx, signal_base + static_cast<int64_t>(my_rank) * signal_stride, peer);
    pto::comm::Signal sig(remote_signal);
    pto::comm::TNOTIFY(sig, static_cast<int32_t>(1), pto::comm::NotifyOp::AtomicAdd);
  }
  for (int peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    pto::comm::Signal sig(signal_base + static_cast<int64_t>(peer) * signal_stride);
    pto::comm::TWAIT(sig, static_cast<int32_t>(1), pto::comm::WaitCmp::GE);
  }
  for (int peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    pto::comm::Signal self_sig(signal_base + static_cast<int64_t>(peer) * signal_stride);
    pto::comm::TNOTIFY(self_sig, static_cast<int32_t>(-1), pto::comm::NotifyOp::AtomicAdd);
  }
}

}  // namespace

extern "C" __aicore__ __attribute__((always_inline)) void kernel_entry(__gm__ int64_t *args) {
  __gm__ Tensor *input_tensor = reinterpret_cast<__gm__ Tensor *>(args[0]);
  __gm__ Tensor *target_tensor = reinterpret_cast<__gm__ Tensor *>(args[1]);
  __gm__ Tensor *signal_tensor = reinterpret_cast<__gm__ Tensor *>(args[2]);
  __gm__ Tensor *send_counts_tensor = reinterpret_cast<__gm__ Tensor *>(args[3]);
  __gm__ Tensor *recv_counts_tensor = reinterpret_cast<__gm__ Tensor *>(args[4]);
  // args[5] = CommContext* on both rails (HOST builtin and CHIP MaterializeDistTensorCtx;
  // extra ctx pointers at args[6..] are unread duplicates). nranks from rankNum —
  // no separate rank-count scalar — keeps one kernel source for both rails.
  __gm__ CommContext *comm_ctx = reinterpret_cast<__gm__ CommContext *>(args[5]);
  int nranks = static_cast<int>(comm_ctx->rankNum);

  // Early returns below must agree on every rank: asymmetric return leaves peers
  // blocked in ExchangeBarrier (hang, not corruption).
  if (nranks <= 0 || nranks > kMaxSupportedRanks) {
    pipe_barrier(PIPE_ALL);
    return;
  }

  int my_rank = static_cast<int>(comm_ctx->rankId);

  // target is [NR * MAX_RECV, SIZE]; derive MAX_RECV from runtime nranks so an
  // over-provisioned signal cannot silently change the per-dest block size.
  int64_t max_recv = static_cast<int64_t>(target_tensor->shapes[0]) / nranks;
  if (max_recv <= 0) {
    pipe_barrier(PIPE_ALL);
    return;
  }

  int64_t row_numel = 1;
  for (uint32_t dim = 1; dim < target_tensor->ndims; ++dim) {
    row_numel *= static_cast<int64_t>(target_tensor->shapes[dim]);
  }
  if (row_numel <= 0) {
    pipe_barrier(PIPE_ALL);
    return;
  }

  // Distinct windows (same race rationale as symmetric all_to_all).
  __gm__ {{dtype_cpp}} *input_local =
      reinterpret_cast<__gm__ {{dtype_cpp}} *>(input_tensor->buffer.addr) + input_tensor->start_offset;
  __gm__ {{dtype_cpp}} *target =
      reinterpret_cast<__gm__ {{dtype_cpp}} *>(target_tensor->buffer.addr) + target_tensor->start_offset;
  __gm__ int32_t *signal_base =
      reinterpret_cast<__gm__ int32_t *>(signal_tensor->buffer.addr) + signal_tensor->start_offset;
  __gm__ int32_t *send_counts_base =
      reinterpret_cast<__gm__ int32_t *>(send_counts_tensor->buffer.addr) + send_counts_tensor->start_offset;
  __gm__ int32_t *recv_counts_base =
      reinterpret_cast<__gm__ int32_t *>(recv_counts_tensor->buffer.addr) + recv_counts_tensor->start_offset;

  // Signal [NR, 1] (or rank-1 [NR]): barrier only. Counts publish on recv_counts
  // via TNOTIFY(Set) in the push loop — Yunji's spec: rely on Phase B consumer
  // invalidate for visibility, no AtomicAdd/TWAIT encoding.
  int64_t signal_cols = 1;
  if (signal_tensor->ndims >= 2) {
    signal_cols = static_cast<int64_t>(signal_tensor->shapes[1]);
  }
  if (signal_cols < 1) {
    pipe_barrier(PIPE_ALL);
    return;
  }

  using ShapeDyn = pto::Shape<pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC>;
  using StrideDyn = pto::Stride<pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC>;
  using Global = pto::GlobalTensor<{{dtype_cpp}}, ShapeDyn, StrideDyn, pto::Layout::ND>;
  using TileData = pto::Tile<pto::TileType::Vec, {{dtype_cpp}}, 1, kTileCount, pto::BLayout::RowMajor, -1, -1>;

  // Staging tile width is kTileCount; TPUT_IMPL chunks larger payloads against GetValidCol().
  // TASSIGN(0x0) is dtype-agnostic (0x10000 was FP32-only).
  TileData send_tile(1, kTileCount);
  TASSIGN(send_tile, 0x0);

  // Entry sync: with reset_persistent_windows=False, round N+1 must not push while a
  // peer is still in round N. Single-block only; multi-block soft-sync is not here.
  ExchangeBarrier(comm_ctx, signal_base, my_rank, nranks, signal_cols);

  // Push loop: for each dest (including self), publish count then TPUT payload.
  // Yunji spec: TNOTIFY(Set, rows) on recv_counts in-loop; rely on Phase B
  // consumer invalidate for visibility after the completion barrier.
  for (int dest = 0; dest < nranks; ++dest) {
    int32_t raw_count = send_counts_base[dest];
    int64_t rows64 = static_cast<int64_t>(raw_count);
    if (rows64 > max_recv) rows64 = max_recv;
    if (rows64 < 0) rows64 = 0;
    int32_t rows = static_cast<int32_t>(rows64);

    // Publish count to peer's recv_counts[my_rank] (self included per Yunji).
    __gm__ int32_t *remote_recv_slot = CommRemotePtr(comm_ctx, recv_counts_base + my_rank, dest);
    pto::comm::Signal count_sig(remote_recv_slot);
    pto::comm::TNOTIFY(count_sig, rows, pto::comm::NotifyOp::Set);

    int64_t src_row_offset = static_cast<int64_t>(dest) * max_recv * row_numel;
    int64_t dst_row_offset = static_cast<int64_t>(my_rank) * max_recv * row_numel;
    __gm__ {{dtype_cpp}} *remote_block = CommRemotePtr(comm_ctx, target + dst_row_offset, dest);

    // Flat [rows * SIZE] transfer; TPUT_IMPL re-chunks above kTileCount. rows==0 skips.
    int64_t block_numel = rows64 * row_numel;
    if (block_numel > 0) {
      send_tile.ColMaskInternal =
          static_cast<int>(block_numel <= kTileCount ? block_numel : kTileCount);
      ShapeDyn shape(1, 1, 1, 1, block_numel);
      StrideDyn stride(block_numel, block_numel, block_numel, block_numel, 1);
      Global src_g(input_local + src_row_offset, shape, stride);
      Global dst_g(remote_block, shape, stride);

      pto::comm::TPUT(dst_g, src_g, send_tile);
    }
  }

  // Completion barrier: GM fence + N-way barrier.
  // Yunji spec: notify(set) + fence(dsb) + barrier(notify+wait) should
  // make recv_counts visible after consumer cache invalidate.
  PublishFence();  // pipe_barrier(PIPE_ALL) + dsb(DSB_DDR)
  ExchangeBarrier(comm_ctx, signal_base, my_rank, nranks, signal_cols);
}
