#ifndef __aicore__
#define __aicore__ [aicore]
#endif

namespace {

static constexpr int64_t kTileCount = 256;
static constexpr int kMaxSupportedRanks = 16;

template <typename T>
AICORE inline __gm__ T *CommRemotePtr(__gm__ CommContext *ctx, __gm__ T *local_ptr, int pe) {
  uint64_t local_base = ctx->windowsIn[ctx->rankId];
  uint64_t offset = reinterpret_cast<uint64_t>(local_ptr) - local_base;
  return reinterpret_cast<__gm__ T *>(ctx->windowsIn[pe] + offset);
}

// Publishes preceding GM/window writes before a notify that another rank
// waits on. Applies whenever a notify releases writes this rank just made —
// remote push completion, a local-window ready-notify for a pull, or a
// count/meta publish riding the same notify as the payload.
AICORE inline void PublishFence() {
  pipe_barrier(PIPE_ALL);
  dsb(DSB_DDR);
}

// Full exchange barrier on `signal_base`: every non-self peer is notified
// (AtomicAdd +1), then waited on (>= 1), then self-cleared (AtomicAdd -1) so
// the window is back at 0 and reusable by the next call. Symmetric in both
// directions, so calling it once per rank rendezvous-blocks every
// participant until all have reached this call site.
//
// This kernel invokes it twice per round on the SAME `signal_base` window
// (start-of-call sync, then end-of-call completion) — safe because a rank
// cannot enter occurrence K+1 before its own occurrence K's wait+self-clear
// returns, and cannot complete occurrence K until the peer has entered its
// own occurrence K. Ranks can therefore drift by at most one occurrence
// relative to each other; a NOTIFY from one occurrence can never satisfy a
// WAIT belonging to a different occurrence. This differs from
// `allreduce_ring`'s per-round barrier, which indexes a distinct signal
// column per round (`signal_base + round * signal_cols`): that barrier only
// synchronizes ring-adjacent neighbours per step, so non-adjacent ranks are
// not bounded to one round apart the way a full N-way rendezvous bounds
// every pair here — column separation is required there, not here.
AICORE inline void ExchangeBarrier(__gm__ CommContext *comm_ctx, __gm__ int32_t *signal_base, int my_rank,
                                    int nranks) {
  for (int peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    __gm__ int32_t *remote_signal = CommRemotePtr(comm_ctx, signal_base + my_rank, peer);
    pto::comm::Signal sig(remote_signal);
    pto::comm::TNOTIFY(sig, static_cast<int32_t>(1), pto::comm::NotifyOp::AtomicAdd);
  }
  for (int peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    pto::comm::Signal sig(signal_base + peer);
    pto::comm::TWAIT(sig, static_cast<int32_t>(1), pto::comm::WaitCmp::GE);
  }
  for (int peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    pto::comm::Signal self_sig(signal_base + peer);
    pto::comm::TNOTIFY(self_sig, static_cast<int32_t>(-1), pto::comm::NotifyOp::AtomicAdd);
  }
}

}  // namespace

extern "C" __aicore__ __attribute__((always_inline)) void kernel_entry(__gm__ int64_t *args) {
  __gm__ Tensor *input_tensor = reinterpret_cast<__gm__ Tensor *>(args[0]);
  __gm__ Tensor *target_tensor = reinterpret_cast<__gm__ Tensor *>(args[1]);
  __gm__ Tensor *signal_tensor = reinterpret_cast<__gm__ Tensor *>(args[2]);
  __gm__ Tensor *send_counts_tensor = reinterpret_cast<__gm__ Tensor *>(args[3]);
  __gm__ Tensor *recv_counts_tensor = reinterpret_cast<__gm__ Tensor *>(args[4]);
  // args[5] is the CommContext on BOTH rails, and the rank count comes from the
  // context rather than from a scalar argument:
  //
  //   HOST/L3 builtin dispatch : args[5] = CommContext* (the dispatch emits no
  //                              rank-count scalar for this builtin)
  //   CHIP/L2 managed task     : args[5] = CommContext* — MaterializeDistTensorCtx
  //                              appends one ctx per DistributedTensor param;
  //                              all of them hold the same pointer, and args[6..]
  //                              are the unread duplicates
  //
  // `rankNum` is the domain's rank count: the context is derived per comm
  // domain, so it is exactly the `domain_size` the dispatch used to pass. One
  // GM load at entry buys an argument layout — and therefore a kernel source —
  // that is identical on both rails.
  __gm__ CommContext *comm_ctx = reinterpret_cast<__gm__ CommContext *>(args[5]);
  int nranks = static_cast<int>(comm_ctx->rankNum);

  // This guard, and the two below it (max_recv, row_numel), must evaluate
  // identically on every participating rank for the same call: each derives
  // from comm_ctx/target_tensor shapes that are set up symmetrically across
  // the domain, but if that symmetry were ever broken, one rank taking the
  // early return while its peers reach ExchangeBarrier() below would leave
  // those peers' TWAIT blocked forever (a hang, not data corruption).
  if (nranks <= 0 || nranks > kMaxSupportedRanks) {
    pipe_barrier(PIPE_ALL);
    return;
  }

  int my_rank = static_cast<int>(comm_ctx->rankId);

  // MAX_RECV = target.shape[0] / nranks. target is 2D [NR*MAX_RECV, SIZE] and
  // nranks is the comm-domain size (dispatch scalar 0), so the block geometry
  // below is always consistent with the rank count this kernel actually runs
  // on. Deriving it here instead of baking it at codegen time closes the
  // dynamic-domain hazard where signal.shape[0] is not tied to the runtime
  // world size (an over-provisioned signal would otherwise silently change
  // the per-destination block size).
  int64_t max_recv = static_cast<int64_t>(target_tensor->shapes[0]) / nranks;
  if (max_recv <= 0) {
    pipe_barrier(PIPE_ALL);
    return;
  }

  // row_numel = SIZE (target is 2D [NR*MAX_RECV, SIZE]).
  int64_t row_numel = 1;
  for (uint32_t dim = 1; dim < target_tensor->ndims; ++dim) {
    row_numel *= static_cast<int64_t>(target_tensor->shapes[dim]);
  }
  if (row_numel <= 0) {
    pipe_barrier(PIPE_ALL);
    return;
  }

  // `input` and `target` are two DISTINCT windows — same same-window-race
  // rationale as the symmetric all_to_all kernel.
  __gm__ {{dtype_cpp}} *input_local =
      reinterpret_cast<__gm__ {{dtype_cpp}} *>(input_tensor->buffer.addr) + input_tensor->start_offset;
  __gm__ {{dtype_cpp}} *target =
      reinterpret_cast<__gm__ {{dtype_cpp}} *>(target_tensor->buffer.addr) + target_tensor->start_offset;
  __gm__ int32_t *signal_base =
      reinterpret_cast<__gm__ int32_t *>(signal_tensor->buffer.addr) + signal_tensor->start_offset;
  __gm__ int32_t *send_counts_base =
      reinterpret_cast<__gm__ int32_t *>(send_counts_tensor->buffer.addr) + send_counts_tensor->start_offset;
  __gm__ int32_t *recv_counts_base =
      reinterpret_cast<__gm__ int32_t *>(recv_counts_tensor->buffer.addr) + recv_counts_tensor->start_offset;

  using ShapeDyn = pto::Shape<pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC>;
  using StrideDyn = pto::Stride<pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC>;
  using Global = pto::GlobalTensor<{{dtype_cpp}}, ShapeDyn, StrideDyn, pto::Layout::ND>;
  using TileData = pto::Tile<pto::TileType::Vec, {{dtype_cpp}}, 1, kTileCount, pto::BLayout::RowMajor, -1, -1>;

  // UB staging-tile column capacity: fixed at kTileCount regardless of
  // row_numel. TPUT_IMPL reads this once (TileData::GetValidCol()) and
  // slides its own 2D chunked transfer against it for any larger extent —
  // the transport chunk size must depend only on total contiguous payload
  // length, never on the logical row width.
  TileData send_tile(1, kTileCount);
  TASSIGN(send_tile, 0x10000);

  // Start-of-call global sync: under persistent execution with
  // reset_persistent_windows=False, this call's TPUTs below must not begin
  // until every rank has actually reached this call — otherwise this rank's
  // round-N+1 write can race a peer still finishing round N. This kernel has
  // no block_idx today (single AIV block only), so the cross-rank exchange
  // below is the whole story; a multi-block launch would additionally need
  // every block_idx != 0 to wait on block 0 via a soft sync_call before
  // pushing (block 0's start point stands for the whole launch cohort, since
  // launch is require_sync_start) — not implemented, no-op until block_num>1.
  ExchangeBarrier(comm_ctx, signal_base, my_rank, nranks);

  // Snapshot peer send_counts[my_rank] now (after start barrier, before any
  // peer can exit the end barrier and rewrite its counts window for a later
  // round). Phase 2 uses these clamped values — not a post-completion remote
  // re-read — so recv_counts always matches the payload transferred this call.
  int32_t peer_recv_rows[kMaxSupportedRanks];
  for (int src = 0; src < nranks; ++src) {
    if (src == my_rank) {
      peer_recv_rows[src] = 0;
      continue;
    }
    __gm__ int32_t *remote_send_slot = CommRemotePtr(comm_ctx, send_counts_base + my_rank, src);
    __asm__ __volatile__("");
    dcci(reinterpret_cast<__gm__ void *>(remote_send_slot), SINGLE_CACHE_LINE);
    __asm__ __volatile__("");
    int64_t rows64 = static_cast<int64_t>(*remote_send_slot);
    if (rows64 > max_recv) rows64 = max_recv;
    if (rows64 < 0) rows64 = 0;
    peer_recv_rows[src] = static_cast<int32_t>(rows64);
  }

  // Self-slot clamped count, captured in the dest loop below and written to
  // local recv_counts after the completion barrier (see Phase 2).
  int32_t self_rows = 0;

  // ==================================================================
  // Phase 1: per-destination push + inline count publish. Include self
  // (dest == my_rank), matching HCCL identity / the InCore composite's
  // EmitFor over [0, nranks) with no self-exclusion.
  //
  //   rows = clamp(send_counts[dest], 0, max_recv)  -- runtime scalar,
  //          clamped on BOTH sides. Matches LowerTensorAllToAllVRule's
  //          MakeMax(MakeMin(cast(count, INDEX), max_recv), 0) exactly, so
  //          HOST and InCore agree bit-for-bit on every input, including a
  //          negative send_counts.
  //   TNOTIFY(recv_counts[dest]'s window, slot my_rank) = rows  (Set)
  //        — best-effort early publish (matches InCore); NOT authoritative on
  //        HOST/L2. Remote NotifyOp::Set is a posted GM store; barrier
  //        AtomicAdd on a different address does not prove it is visible
  //        (CI flake: peer recv_counts=0). Phase 2 re-derives every local
  //        slot after the completion barrier.
  //   TPUT input[dest*max_recv : dest*max_recv + rows, :]
  //        -> target[my_rank*max_recv : my_rank*max_recv + rows, :]
  //
  // The TPUT transfers exactly `rows` rows, not the full max_recv capacity —
  // only the payload crosses the interconnect. Rows past `rows` in the
  // destination's capacity slot are simply not written, and the receiver
  // identifies the valid ones via recv_counts (unchanged semantics).
  //
  // The unwritten tail of the destination's capacity slot therefore holds
  // whatever was already in the window. Window memory is not *guaranteed*
  // zeroed and can carry over within a process, so those bytes are undefined
  // (a freshly allocated window has been seen reading zero, and a reused one
  // reading values like -1.2e+32).
  // Previously the full-capacity push filled them with the sender's surplus
  // rows, which were equally meaningless but were always FINITE FP32. The tail
  // has therefore changed in KIND, not just in value: uninitialised bytes may
  // decode as NaN/Inf. A consumer that reduces over the dense capacity block
  // and masks by recv_counts afterwards - the natural MoE dispatch shape - was
  // correct before and would now propagate NaN into valid rows. Trim to
  // recv_counts BEFORE computing.
  // recv_counts is what makes either correct, and always was: only code reading
  // past recv_counts can tell the difference, and it was already reading data
  // it had no right to.
  //
  // InCore/HOST wire parity is deliberate and preserved: LowerTensorAllToAllVRule
  // emits the same [rows, SIZE] transfer, so the two lowering paths stay
  // bit-for-bit identical and there is no second, divergent implementation.
  // ==================================================================
  for (int dest = 0; dest < nranks; ++dest) {
    int32_t raw_count = send_counts_base[dest];
    int64_t rows64 = static_cast<int64_t>(raw_count);
    if (rows64 > max_recv) rows64 = max_recv;
    if (rows64 < 0) rows64 = 0;
    int32_t rows = static_cast<int32_t>(rows64);

    if (dest == my_rank) {
      self_rows = rows;
    }
    // Best-effort early count publish (InCore wire parity). Phase 2 overwrites
    // every local recv_counts slot from register / peer send_counts.
    __gm__ int32_t *remote_recv_slot =
        CommRemotePtr(comm_ctx, recv_counts_base + my_rank, dest);
    pto::comm::Signal count_sig(remote_recv_slot);
    pto::comm::TNOTIFY(count_sig, rows, pto::comm::NotifyOp::Set);

    int64_t src_row_offset = static_cast<int64_t>(dest) * max_recv * row_numel;
    int64_t dst_row_offset = static_cast<int64_t>(my_rank) * max_recv * row_numel;
    __gm__ {{dtype_cpp}} *remote_block = CommRemotePtr(comm_ctx, target + dst_row_offset, dest);

    // The pushed block [rows, SIZE] is contiguous in the dense row-major
    // [NR*max_recv, SIZE] layout, so it is one flat 1D transfer (same shape
    // as symmetric all_to_all's single-row transfer, generalized to
    // rows*row_numel elements). One TPUT call covers the whole block: for
    // block_numel > kTileCount, TPUT_IMPL's own TputProcessSlice re-chunks
    // internally at kTileCount granularity — the same granularity we used to
    // hand-chunk at whenever row_numel >= kTileCount (below that, the old
    // code's tile_cols was min(row_numel, kTileCount), a smaller chunk) —
    // via TLOAD -> event-flag sync -> TSTORE per chunk (TputTransferOnce) —
    // this halves the pipe_barrier(PIPE_ALL) count per chunk (was 2 from our
    // own bracketing; TPUT_IMPL's TputTransferOnce still issues 1 of its own),
    // it does not eliminate chunking or engage ping-pong: this tile's Rows=1
    // fails TPUT_IMPL's canSplitTile Rows%2==0 gate, so intra-tile ping-pong
    // never triggers for this kernel's shape regardless of chunk count.
    // rows == 0 makes block_numel 0 and the guard below skips the TPUT
    // entirely — matching the InCore rail's rows > 0 guard.
    int64_t block_numel = rows64 * row_numel;
    if (block_numel > 0) {
      // Re-set ColMaskInternal before every destination's TPUT — two distinct
      // reasons, both mandatory:
      //  (1) TPUT_IMPL's internal chunk loop (TputProcessSlice) writes the
      //      caller's tile ColMaskInternal to each ragged tail chunk and never
      //      restores it; send_tile is reused across the whole dest loop, so a
      //      prior destination's remainder would shrink every later dest's
      //      chunk size (order-dependent perf/correctness drift).
      //  (2) GetValidCol() at TPUT_IMPL entry sizes the hardware fast path —
      //      without capping to block_numel, a short payload (e.g. rows==1)
      //      would DMA the full kTileCount width off GM.
      send_tile.ColMaskInternal =
          static_cast<int>(block_numel <= kTileCount ? block_numel : kTileCount);
      ShapeDyn shape(1, 1, 1, 1, block_numel);
      StrideDyn stride(block_numel, block_numel, block_numel, block_numel, 1);
      Global src_g(input_local + src_row_offset, shape, stride);
      Global dst_g(remote_block, shape, stride);

      pto::comm::TPUT(dst_g, src_g, send_tile);
    }
  }

  // ==================================================================
  // Phase 2: publish fence, then notify peers and wait for all
  // (NotifyOp::AtomicAdd) via the same self-clearing exchange barrier used
  // at start-of-call — this occurrence releases this call's completion to
  // its peers, rather than gating this call's start.
  // ==================================================================
  PublishFence();
  ExchangeBarrier(comm_ctx, signal_base, my_rank, nranks);
  // Authoritative local recv_counts fill (Phase 2). Do NOT rely on the Phase 1
  // remote TNOTIFY(Set) being visible here: that path races under NPU load.
  // Self: register-captured clamped rows. Peers: use peer_recv_rows snapshotted
  // after the start barrier (not a post-completion remote re-read — a fast peer
  // may already be staging the next round's send_counts). Local stores + local
  // TNOTIFY(Set) + consume-side Phase B invalidate close both self and peer
  // recv_counts=0 flakes without spinning on remote Sets.
  for (int src = 0; src < nranks; ++src) {
    int32_t rows = (src == my_rank) ? self_rows : peer_recv_rows[src];
    recv_counts_base[src] = rows;
    pto::comm::Signal count_sig(recv_counts_base + src);
    pto::comm::TNOTIFY(count_sig, rows, pto::comm::NotifyOp::Set);
  }
  pipe_barrier(PIPE_ALL);
  dsb(DSB_DDR);
}
