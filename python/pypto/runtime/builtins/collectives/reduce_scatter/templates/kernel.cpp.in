// Generated from {{template_package}}.
#include <cstdint>

#ifndef __gm__
#define __gm__
#endif

#ifndef __aicore__
#if defined(__CPU_SIM)
#define __aicore__
#else
#define __aicore__ [aicore]
#endif
#endif

// Keep this after the qualifier fallbacks so hardware builds retain the
// [aicore] entry annotation while using simpler's logical SPMD context.
// get_block_idx/get_block_num (RFC #2521 plan 85/B6b) come from here.
#include "intrinsic.h"

#include <pto/pto-inst.hpp>
#include "tensor.h"
#include "platform_comm/comm_context.h"


#if defined(__CPU_SIM)
// PTOAS v0.50+ emits cache_line_t::ENTIRE_DATA_CACHE / SINGLE_CACHE_LINE as
// scoped identifiers, but the pto-isa cpu_stub.hpp defines them as bare macros
// (#define ENTIRE_DATA_CACHE 0) — which breaks cache_line_t::ENTIRE_DATA_CACHE
// into cache_line_t::0. Undefine the macros and provide proper namespace-scoped
// constexpr constants. The same headers also #define dcci/dsb as macros that
// would expand our own inlines, so undefine + redefine all of them here.
#include <atomic>

// Forward-declare the overloads so the undefs below don't break chained includes.
namespace pypto_sim_detail {
    template <typename... Args>
    static inline void sim_dcci(Args...);  // defined after the undefs
    static inline void sim_dsb(int kind);  // ditto
}

// Undefine conflicting macros from pto-isa cpu_stub.hpp / inner_kernel.h
// so our namespace-scoped constants and inline functions are used instead.
#undef ENTIRE_DATA_CACHE
#undef SINGLE_CACHE_LINE
#undef DSB_DDR
#undef dcci
#undef dsb
#undef CACHELINE_OUT

namespace cache_line_t {
    constexpr int ENTIRE_DATA_CACHE = 0;
    constexpr int SINGLE_CACHE_LINE = 0;
    constexpr int CACHELINE_OUT     = 0;
}
typedef int mem_dsb_t;
#define DSB_DDR 0

static inline void dcci(...) {
    std::atomic_thread_fence(std::memory_order_seq_cst);
}
static inline void dsb(mem_dsb_t) {
    std::atomic_thread_fence(std::memory_order_seq_cst);
}
#endif  // __CPU_SIM

using namespace pto;

namespace {

// UB tile width, in elements. Only the tile has to fit in UB, not the row, so
// SIZE is unconstrained.
static constexpr int64_t kTileCount = 256;
static constexpr int kMaxSupportedRanks = 16;
static constexpr int kTransferAlignmentBytes = 32;
static_assert(kTransferAlignmentBytes % sizeof({{dtype_cpp}}) == 0,
              "transfer alignment must be a whole number of elements");

// UB addresses of the two tiles. 64KB apart, so they never overlap at any
// supported tile width.
static constexpr uint64_t kAccTileAddr = 0x0;
static constexpr uint64_t kRecvTileAddr = 0x10000;

// One UB-wide slice of one tensor row.
using RowShape = Shape<1, 1, 1, 1, -1>;
using RowStride = Stride<-1, -1, -1, -1, -1>;
using RowSlice = GlobalTensor<{{dtype_cpp}}, RowShape, RowStride, Layout::ND>;

using DataTile = Tile<TileType::Vec, {{dtype_cpp}}, 1, kTileCount, BLayout::RowMajor, -1, -1,
                      SLayout::NoneBox, 512, PadValue::Null, CompactMode::Null>;

// The same object inside `pe`'s window: byte offsets are identical across
// windows, so rebasing the local pointer is enough.
template <typename T>
static __aicore__ inline __gm__ T *CommRemotePtr(__gm__ CommContext *ctx, __gm__ T *local_ptr, int pe) {
  uint64_t local_base = ctx->windowsIn[ctx->rankId];
  uint64_t offset = reinterpret_cast<uint64_t>(local_ptr) - local_base;
  return reinterpret_cast<__gm__ T *>(ctx->windowsIn[pe] + offset);
}

}  // namespace

extern "C" __aicore__ __attribute__((always_inline)) void kernel_entry(__gm__ int64_t *args) {
  __gm__ Tensor *target_tensor = reinterpret_cast<__gm__ Tensor *>(args[0]);
  __gm__ Tensor *signal_tensor = reinterpret_cast<__gm__ Tensor *>(args[1]);
  int nranks = static_cast<int>(args[2]);
  __gm__ CommContext *comm_ctx = reinterpret_cast<__gm__ CommContext *>(args[3]);
  int32_t block_idx = get_block_idx(args);
  int32_t block_num = get_block_num(args);

  if (nranks <= 0 || nranks > kMaxSupportedRanks || target_tensor->ndims < 2 || block_num <= 0 ||
      block_idx < 0 || block_idx >= block_num) {
    pipe_barrier(PIPE_ALL);
    return;
  }

  // Derive the row length from the tensor's own trailing dim rather than
  // numel / nranks: target is [NR, SIZE] with NR carried as a dynamic dim, and
  // the caller's NR is not guaranteed to equal the runtime rank count.
  const int64_t rows = static_cast<int64_t>(target_tensor->shapes[0]);
  const int64_t row_elems = static_cast<int64_t>(target_tensor->shapes[target_tensor->ndims - 1]);
  if (rows < nranks || row_elems <= 0) {
    pipe_barrier(PIPE_ALL);
    return;
  }

  __gm__ {{dtype_cpp}} *target =
      reinterpret_cast<__gm__ {{dtype_cpp}} *>(target_tensor->buffer.addr) + target_tensor->start_offset;
  __gm__ int32_t *signal_base =
      reinterpret_cast<__gm__ int32_t *>(signal_tensor->buffer.addr) + signal_tensor->start_offset;

  // RFC #2521 plan 85/B6b: same block-indexed signal-lane contract as
  // allreduce's mesh kernel (#2160) — every signal lane is addressed as
  // `peer * signal_stride + block_idx`, so a block index at or beyond
  // `signal_stride` would run off the end of its own peer row. Clamp the
  // participating block count instead of letting that corruption happen
  // silently; `signal_stride` is identical on every rank, so the same
  // minimum on each rank keeps the protocol symmetric.
  const int64_t signal_stride =
      signal_tensor->ndims == 1 ? 1 : static_cast<int64_t>(signal_tensor->shapes[1]);
  const int32_t active_blocks =
      block_num < static_cast<int32_t>(signal_stride) ? block_num : static_cast<int32_t>(signal_stride);
  if (block_idx >= active_blocks) {
    pipe_barrier(PIPE_ALL);
    return;
  }

#if defined(__DAV_VEC__)
  set_mask_norm();
  set_vector_mask(-1, -1);

  // Seed the two events the tile loop consumes on its first iteration: the
  // store->load dependency across tiles, and the add->load dependency across
  // peers. Both are drained after the epilogue.
  set_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
  set_flag(PIPE_V, PIPE_MTE2, EVENT_ID0);

  const int64_t my_rank = static_cast<int64_t>(comm_ctx->rankId);
  __gm__ {{dtype_cpp}} *my_row = target + my_rank * row_elems;

  // Phase 1: ready barrier — publish that this rank's input rows are written,
  // and wait until every peer's are too, before any remote read starts.
  // Block-indexed lane: `block_idx` picks this block's column in the
  // [peer, signal_stride] signal, so concurrent blocks never share a cell.
  for (int64_t peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    pto::comm::Signal cell(
        CommRemotePtr(comm_ctx, signal_base + my_rank * signal_stride + block_idx, peer));
    pipe_barrier(PIPE_ALL);
    pto::comm::TNOTIFY(cell, static_cast<int32_t>(1), pto::comm::NotifyOp::AtomicAdd);
  }
  for (int64_t peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    pto::comm::Signal cell(signal_base + peer * signal_stride + block_idx);
    pto::comm::TWAIT(cell, static_cast<int32_t>(1), pto::comm::WaitCmp::GE);
    dcci((__gm__ void *)0, cache_line_t::ENTIRE_DATA_CACHE);
  }

  // Phase 2: UB-tile this rank's OWN row and reduce it across every peer.
  // Rank r reads row r from each peer and writes only row r of its own window;
  // no peer ever reads row r there, so reads and writes are region-disjoint
  // across ranks. That is why the store can stay inside the tile loop and the
  // read-complete barrier below runs once for the whole row — the credit total
  // is a constant 2 no matter how many tiles the row splits into. Each block
  // owns a disjoint, strided slice of the row (`active_blocks`-wide stride),
  // so blocks are also region-disjoint from each other within the row.
  for (int64_t off = static_cast<int64_t>(block_idx) * kTileCount; off < row_elems;
       off += static_cast<int64_t>(active_blocks) * kTileCount) {
    const int64_t remaining = row_elems - off;
    const int64_t chunk = remaining < kTileCount ? remaining : kTileCount;
    const int chunk_i = static_cast<int>(chunk);
    const int transfer_chunk =
        ((chunk_i * static_cast<int>(sizeof({{dtype_cpp}})) + kTransferAlignmentBytes - 1) /
         kTransferAlignmentBytes) *
        (kTransferAlignmentBytes / static_cast<int>(sizeof({{dtype_cpp}})));

    RowSlice my_load_slice(my_row + off, RowShape(1, 1, 1, 1, transfer_chunk),
                           RowStride(row_elems, row_elems, row_elems, row_elems, 1));
    RowSlice my_store_slice(my_row + off, RowShape(1, 1, 1, 1, chunk),
                            RowStride(row_elems, row_elems, row_elems, row_elems, 1));
    DataTile acc(1, kTileCount);
    TASSIGN(acc, kAccTileAddr);
    acc.SetValidShape(1, transfer_chunk);

    wait_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
    TLOAD(acc, my_load_slice);
    set_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);

    for (int64_t peer = 0; peer < nranks; ++peer) {
      if (peer == my_rank) continue;
      DataTile recv(1, kTileCount);
      TASSIGN(recv, kRecvTileAddr);
      recv.SetValidShape(1, transfer_chunk);
      RowSlice peer_slice(CommRemotePtr(comm_ctx, my_row + off, peer),
                          RowShape(1, 1, 1, 1, transfer_chunk),
                          RowStride(row_elems, row_elems, row_elems, row_elems, 1));
      wait_flag(PIPE_V, PIPE_MTE2, EVENT_ID0);
      TLOAD(recv, peer_slice);
      set_flag(PIPE_MTE2, PIPE_V, EVENT_ID0);
      wait_flag(PIPE_MTE2, PIPE_V, EVENT_ID0);
      TADD(acc, acc, recv);
      set_flag(PIPE_V, PIPE_MTE2, EVENT_ID0);
    }

    // The store waits on both the accumulate chain and this tile's own-row load.
    set_flag(PIPE_V, PIPE_MTE3, EVENT_ID0);
    wait_flag(PIPE_V, PIPE_MTE3, EVENT_ID0);
    wait_flag(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
    acc.SetValidShape(1, chunk_i);
    TSTORE(my_store_slice, acc);
    // Order this store ahead of the next tile's load of the same row.
    set_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
    dcci((__gm__ void *)(my_row + off), cache_line_t::SINGLE_CACHE_LINE);
    pipe_barrier(PIPE_ALL);
    dsb(DSB_DDR);
  }

  // Phase 3: read-complete barrier — no rank may return, and let the host reuse
  // this window, until every peer has finished reading from it.
  for (int64_t peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    pto::comm::Signal cell(
        CommRemotePtr(comm_ctx, signal_base + my_rank * signal_stride + block_idx, peer));
    pipe_barrier(PIPE_ALL);
    pto::comm::TNOTIFY(cell, static_cast<int32_t>(1), pto::comm::NotifyOp::AtomicAdd);
  }
  for (int64_t peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    pto::comm::Signal cell(signal_base + peer * signal_stride + block_idx);
    pto::comm::TWAIT(cell, static_cast<int32_t>(2), pto::comm::WaitCmp::GE);
    dcci((__gm__ void *)0, cache_line_t::ENTIRE_DATA_CACHE);
  }

  // Self-clearing epilogue: exactly two credits per peer cell this call (ready +
  // read-complete), independent of SIZE. AtomicAdd keeps the reset commutative
  // with a fast peer's next-call +1, so no in-flight credit can be lost; a
  // Set(0) here would wipe it and deadlock that peer's following wait.
  for (int64_t peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    pto::comm::Signal cell(signal_base + peer * signal_stride + block_idx);
    pipe_barrier(PIPE_ALL);
    pto::comm::TNOTIFY(cell, static_cast<int32_t>(-2), pto::comm::NotifyOp::AtomicAdd);
  }

  // Drain the two events seeded at entry.
  wait_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
  wait_flag(PIPE_V, PIPE_MTE2, EVENT_ID0);
#endif  // __DAV_VEC__

  pipe_barrier(PIPE_ALL);
}
