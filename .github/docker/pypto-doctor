#
# Check that this container can actually build PyPTO and reach a card, and say
# precisely what to do about anything that cannot. Every check is cheap; run it
# whenever something behaves oddly, and always before blaming a kernel.
set -uo pipefail

if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
    echo 'Usage: pypto-doctor (checks toolchain, checkout, and NPU access)'
    exit 0
fi
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$here/pypto-activate.sh"
source "$here/pypto-owner.sh"

fail=0
ok()   { printf '  \033[32mok\033[0m    %s\n' "$*"; }
warn() { printf '  \033[33mwarn\033[0m  %s\n' "$*"; }
bad()  { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; fail=1; }

echo "toolchain"
py="$(python -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null || echo none)"
case "$py" in
    3.10.*) ok "python $py (matches CI)" ;;
    *) bad "python is $py — ptoas ships a cp310 wheel and PyPTO's env must be 3.10" ;;
esac
if gxx="$($CXX -dumpversion 2>/dev/null)"; then ok "host compiler $CXX $gxx"; else
    bad "host compiler $CXX not found — simpler builds its runtime and orchestration .so with it"
fi
# Only the CPU simulator platforms need g++-15; the on-device path does not.
if command -v g++-15 >/dev/null 2>&1; then
    ok "g++-15 present — simulator platforms (a5sim/a2a3sim) available"
else
    warn "no g++-15 — on-device platforms work, --platform=a5sim/a2a3sim will not (build the 'sim' target)"
fi
# grep reads the library directly rather than `strings ... | grep -q`: under the
# `pipefail` above, grep -q exits at the first match, strings then dies of
# SIGPIPE, and the pipeline reports failure for a library that is in fact fine.
if grep -q GLIBCXX_3.4.29 /usr/lib/*-linux-gnu/libstdc++.so.6 2>/dev/null; then
    ok "libstdc++ has GLIBCXX_3.4.29"
else
    bad "libstdc++ lacks GLIBCXX_3.4.29 — ptoas will not load"
fi
if ptoas_v="$("$PTOAS_ROOT/bin/ptoas" --version 2>&1)"; then
    if version_check="$(python - "$PYPTO_SRC/toolchain/versions.env" "$ptoas_v" 2>&1 <<'PY'
import pathlib
import re
import sys

pin = re.search(r"^PTOAS_VERSION=v?([0-9.]+)$", pathlib.Path(sys.argv[1]).read_text(), re.M)
found = re.search(r"\bptoas\s+(?:version\s+)?v?([0-9]+(?:\.[0-9]+)+)", sys.argv[2])
if pin is None or found is None:
    sys.exit("Cannot determine PTOAS versions; run pypto-install-ptoas.sh")
if tuple(map(int, found[1].split("."))) < tuple(map(int, pin[1].split("."))):
    sys.exit(f"PTOAS {found[1]} is older than {pin[1]}; run pypto-install-ptoas.sh")
print(sys.argv[2])
PY
    )"; then ok "$version_check"; else bad "$version_check"; fi
else
    bad "ptoas is not runnable: $ptoas_v; run pypto-install-ptoas.sh"
fi

echo "CANN and driver"
cann=""
# ASCEND_HOME_PATH, not ASCEND_TOOLKIT_HOME: simpler_setup/toolchain.py resolves
# every compiler below from ASCEND_HOME_PATH, so checking anything else can pass
# here and still fail at the first assemble.
if [ -n "${ASCEND_HOME_PATH:-}" ]; then
    cann="$(sed -n 's/^Version=//p' "$ASCEND_HOME_PATH/compiler/version.info" 2>/dev/null | head -1)"
    ok "CANN ${cann:-unknown} at $ASCEND_HOME_PATH"
else
    bad "CANN set_env.sh did not run — is this the CANN-based image?"
fi
# Exactly the binaries the on-device path shells out to: CCECToolchain takes
# bin/ccec and bin/ld.lld, Aarch64GxxToolchain the hcc cross pair. Each of those
# constructors raises FileNotFoundError when its binary is absent, so a missing
# one is a hard failure rather than a degraded mode.
for tool in "${ASCEND_HOME_PATH:-/missing-cann}/bin/ccec" \
            "${ASCEND_HOME_PATH:-/missing-cann}/bin/ld.lld" \
            "${ASCEND_HOME_PATH:-/missing-cann}/tools/hcc/bin/aarch64-target-linux-gnu-g++" \
            "${ASCEND_HOME_PATH:-/missing-cann}/tools/hcc/bin/aarch64-target-linux-gnu-gcc"; do
    if [ -x "$tool" ]; then ok "$(basename "$tool")"; else
        bad "missing $tool — in-core/device compilation will fail on this base tag"
    fi
done
# Ascend-Docker-Runtime injects the driver as include/ + lib64/ only, without
# version.info. In that mode compatibility still needs a host-side check; the
# ACL probe establishes access, not whether AICPU initialization will work.
driver_root="${ASCEND_DRIVER_ROOT:-/usr/local/Ascend/driver}"
if [ -r "$driver_root/version.info" ]; then
    driver="$(sed -n 's/^Version=//p' "$driver_root/version.info" | head -1)"
    # Supported pairs from runtime/docs/install.md. compatible_version contains
    # internal V100R... identifiers, not public CANN release numbers.
    case "$cann:$driver" in
        9.0.0:26.0.rc1|9.1.T500:25.6.rc1.b108)
            ok "host driver $driver matches supported CANN $cann" ;;
        9.0.0:*) bad "host driver ${driver:-unknown} is unsupported for CANN $cann; expected 26.0.rc1" ;;
        9.1.T500:*) bad "host driver ${driver:-unknown} is unsupported for CANN $cann; expected 25.6.rc1.b108" ;;
        *) bad "cannot verify host driver ${driver:-unknown} for CANN ${cann:-unknown}; see runtime/docs/install.md for supported pairs" ;;
    esac
elif [ -d "$driver_root/lib64" ]; then
    warn "driver libs present but version.info is not exposed (normal under --runtime=ascend); verify the supported CANN/driver pair on the host"
else
    bad "no host driver in this container — pass the card in with --runtime=ascend, or mount /usr/local/Ascend/driver"
fi
davinci="$(ls /dev/davinci[0-9]* 2>/dev/null | tr '\n' ' ')"
if [ -n "$davinci" ]; then ok "devices: $davinci"; else
    bad "no /dev/davinci* — pass the card in with --device /dev/davinci0 --device /dev/davinci_manager ..."
fi
# npu-smi is diagnostics, never a gate: it enumerates every board on the host, so
# under Ascend-Docker-Runtime — where the container is deliberately given one
# card — it fails with -9005 while compute works perfectly. Only the ACL check
# below decides.
if command -v npu-smi >/dev/null 2>&1; then
    if npu_out="$(npu-smi info 2>&1)"; then
        ok "npu-smi sees $(printf '%s\n' "$npu_out" | grep -cE '^\| [0-9]+ ') chip line(s)"
    else
        warn "npu-smi: $(printf '%s\n' "$npu_out" | head -1) — expected under --runtime=ascend (it enumerates all boards); see the device access check below"
    fi
else
    warn "npu-smi not present — device checks fall back to the ACL probe below"
fi

# The check that actually matters: can this container open a card? Everything
# above is necessary but not sufficient, and this is the exact call that fails
# when the container lacks device access — aclrtSetDevice, the same entry point
# simpler's runtime goes through.
#
# Run against CANN's own interpreter, not PyPTO's venv: the `acl` module is a
# compiled extension shipped for the base image's Python (3.11 or 3.12), so it
# cannot be imported from the 3.10 venv this script otherwise runs in.
device_id="${PYPTO_DEVICE:-0}"
cann_py="$(ls -d /usr/local/python3.*/bin/python3 2>/dev/null | head -1)"
if [ -z "$cann_py" ]; then
    bad "no CANN interpreter found under /usr/local/python3.* — cannot probe device access"
elif acl_out="$(PYTHONPATH="${ASCEND_HOME_PATH:-/missing-cann}/python/site-packages" "$cann_py" -c '
import sys
import acl
init = acl.init()
dev = acl.rt.set_device(int(sys.argv[1]))
# A failed device selection must remain a failure, not get masked by a memory query.
total = acl.rt.get_mem_info(1)[1] if init == 0 and dev == 0 else 0
print("%d %d %d" % (init, dev, total // 1024 // 1024))
' "$device_id" 2>/dev/null)"; then
    set -- $acl_out
    if [ "${1:-1}" = 0 ] && [ "${2:-1}" = 0 ]; then
        ok "device access: aclrtSetDevice($device_id) ok, ${3}MB HBM visible"
    else
        bad "device access refused (device $device_id): acl.init=$1 aclrtSetDevice=$2"
        echo "        the container cannot reach a card. Either run it with"
        echo "        --runtime=ascend -e ASCEND_VISIBLE_DEVICES=<card> (needs"
        echo "        Ascend-Docker-Runtime registered on the host), or --privileged."
    fi
else
    bad "could not run the ACL device probe — repair the CANN interpreter/acl installation before using this environment"
fi

echo "checkout"
if [ -f "$PYPTO_SRC/CMakeLists.txt" ]; then
    ok "pypto at $PYPTO_SRC ($(pypto_as_checkout_owner "$PYPTO_SRC" git -C "$PYPTO_SRC" rev-parse --short HEAD 2>/dev/null || echo 'not a git repo'))"
    if [ -f "$PYPTO_SRC/runtime/pyproject.toml" ]; then
        ok "runtime submodule at $(pypto_as_checkout_owner "$PYPTO_SRC" git -C "$PYPTO_SRC" rev-parse --short HEAD:runtime 2>/dev/null || echo '?')"
    else
        bad "runtime/ is empty — git submodule update --init --recursive"
    fi
else
    bad "no PyPTO checkout at $PYPTO_SRC — mount one at /workspace/pypto"
fi
if [ -d "$PYPTO_LIB_SRC" ]; then ok "pypto-lib at $PYPTO_LIB_SRC"; else
    warn "no pypto-lib at $PYPTO_LIB_SRC — mount it to run the model examples"
fi

echo "build products"
if pypto_file="$(pypto_as_checkout_owner "$PYPTO_SRC" python -c 'import pypto; print(pypto.__file__)' 2>/dev/null)"; then
    ok "import pypto -> $pypto_file"
    case "$pypto_file" in
        "$PYPTO_SRC"/*) ;;
        *) warn "that is NOT the mounted checkout — an installed copy is shadowing it (uv pip uninstall pypto)" ;;
    esac
    so="$(ls "$PYPTO_SRC"/python/pypto/pypto_core*.so 2>/dev/null | head -1)"
    if [ -n "$so" ]; then
        newest="$(find "$PYPTO_SRC/src" "$PYPTO_SRC/include" "$PYPTO_SRC/python/bindings" \
                    \( -name '*.cpp' -o -name '*.h' \) -newer "$so" 2>/dev/null | head -1)"
        if [ -n "$newest" ]; then
            warn "C++ sources are newer than $(basename "$so") — run pypto-build"
        else
            ok "$(basename "$so") is up to date"
        fi
    fi
else
    warn "pypto not importable yet — run pypto-build"
fi
# A site-packages install has no adjacent Git checkout for simpler's own guard.
# Compare its build stamp against the mounted runtime before importing the binding.
if err="$(pypto_as_checkout_owner "$PYPTO_SRC" python -c '
import sys
from pypto.runtime.runtime_pin import runtime_pin_status, runtime_tree_is_dirty
# A diagnostic must inspect the verdict even when the import guard is bypassed.
status = runtime_pin_status()
if status.expected is not None and status.stamp_missing:
    print("installed binding predates revision stamping")
    sys.exit(1)
if status.comparable and not status.matches:
    print(f"installed {status.installed}, runtime/ HEAD {status.expected}")
    sys.exit(1)
import simpler.task_interface
if not status.comparable:
    installed = status.installed or "<unknown>"
    expected = status.expected or "<unknown>"
    print(f"installed {installed}, runtime/ HEAD {expected}")
    sys.exit(4)
# Matching Git revisions cannot establish whether uncommitted ABI edits were built.
sys.exit(3 if runtime_tree_is_dirty(status) else 0)
' 2>&1)"; then
    ok "simpler binding matches its source tree"
else
    result=$?
    if [ "$result" -eq 3 ]; then
        warn "runtime/ has uncommitted changes; the matching build stamp cannot prove the binding is current — rerun pypto-build"
    elif [ "$result" -eq 4 ]; then
        warn "simpler binding revision is unverified: $err — restore runtime/ Git metadata and rerun pypto-build"
    elif printf '%s' "$err" | grep -q 'ModuleNotFoundError'; then
        warn "simpler not installed yet — run pypto-build"
    else
        bad "simpler binding rejected: $(printf '%s\n' "$err" | tail -1)"
        echo "        verify the compiled _task_interface against runtime/ — rerun pypto-build"
    fi
fi

echo
if [ "$fail" -eq 0 ]; then echo "environment looks good."; else
    echo "environment has blocking problems (see FAIL above)."
fi
exit "$fail"
