// Compile-only register pressure fixture; the null UB pointer must not be executed.
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
func.func @no_spill(%n: index) attributes {pto.kernel} {
%c0 = arith.constant 0 : index
%c1 = arith.constant 1 : index
%c64 = arith.constant 64 : index
%addr = arith.constant 0 : i64
%ub = pto.castptr %addr : i64 -> !pto.ptr<f32, ub>
pto.vecscope {
%x = pto.vmi.vload %ub[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
%out = pto.vmi.vadd %x, %x : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xf32>
pto.vmi.vstore %out, %ub[%c0] : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>
}
return
}
}
