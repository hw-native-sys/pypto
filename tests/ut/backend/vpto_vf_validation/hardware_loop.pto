module attributes {pto.target_arch = "a5", pto.backend = "vpto"} {
  func.func @hardware_loop_probe(%arg0: !pto.ptr<f32, ub>) attributes {pto.aiv} {
    %c0_index = arith.constant 0 : index
    %c1_index = arith.constant 1 : index
    %c16_index = arith.constant 16 : index
    %c64_index = arith.constant 64 : index
    %c1024_index = arith.constant 1024 : index
    %c2048_index = arith.constant 2048 : index
    %capture1 = pto.addptr %arg0, %c1024_index : <f32, ub> -> <f32, ub>
    %capture2 = pto.addptr %arg0, %c2048_index : <f32, ub> -> <f32, ub>
    pto.vecscope {
      scf.for %i = %c0_index to %c16_index step %c1_index {
        %offset = arith.muli %i, %c64_index : index
      %x__ssa_v0 = pto.vmi.vload %arg0[%offset] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
      %y__ssa_v0 = pto.vmi.vload %capture1[%offset] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
      %summed__ssa_v0 = pto.vmi.vadd %x__ssa_v0, %y__ssa_v0 {pmode = "zero"} : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xf32>
      %product__ssa_v0 = pto.vmi.vmul %summed__ssa_v0, %y__ssa_v0 {pmode = "zero"} : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xf32>
      %mask__ssa_v0 = pto.vmi.pset "PAT_ALL" : !pto.vmi.mask<64xpred>
      pto.vmi.vstore %product__ssa_v0, %capture2[%offset], %mask__ssa_v0 {pmode = "merge"} : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.vmi.mask<64xpred>
      }
    }
    return
  }
}
