// Compiler-only reduction: intentionally contains no GM input/output or launch.
!tile = !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
module attributes {pto.target_arch = "a5"} {
  module attributes {pto.target_arch = "a5", pto.backend = "emitc"} {
    func.func @body() attributes {pto.kernel_kind = #pto.kernel_kind<vector>, pto.visibility = "external"} {
      %addr = arith.constant 0 : i64
      %tile = pto.alloc_tile addr = %addr : !tile
      func.call @adapter(%tile) : (!tile) -> ()
      return
    }
    func.func private @vf(!pto.ptr<f32, ub>)
    func.func private @adapter(%tile: !tile) attributes {pto.ptodsl.subkernel_helper = "simd", pto.tileop.effects = ["readwrite"]} {
      %ptr = pto.tile_buf_addr %tile : !tile -> !pto.ptr<f32, ub>
      func.call @vf(%ptr) : (!pto.ptr<f32, ub>) -> ()
      return
    }
  }
  module attributes {pto.target_arch = "a5", pto.backend = "vpto"} {
    func.func @vf(%ptr: !pto.ptr<f32, ub>) attributes {pto.aiv} {
      %zero = arith.constant 0 : index
      pto.vecscope {
        %value = pto.vmi.vload %ptr[%zero] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
        pto.vmi.vstore %value, %ptr[%zero] : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>
      }
      return
    }
  }
}
